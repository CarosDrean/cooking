      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Black beans",
          "quantity": 250,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Bacon",
          "quantity": 100,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Pork back ribs",
          "quantity": 500,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Chorizo",
          "quantity": 3,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "Pork shoulder",
          "quantity": 500,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Onion",
          "quantity": 3,
          "unit": "chopped",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 4,
          "unit": "Cloves Chopped",
          "category": "verduras"
        },
        {
          "name": "Chilli flakes",
          "quantity": 1,
          "unit": "Pinch",
          "category": "otros"
        },
        {
          "name": "Oil",
          "quantity": 1,
          "unit": "Drizzle",
          "category": "despensa"
        },
        {
          "name": "Bay leaf",
          "quantity": 2,
          "unit": "unidades",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Heat a large heavy-based saucepan with a fitted lid, add the bacon and fry until crisp"
        },
        {
          "text": "Remove and keep the oil in the pan"
        },
        {
          "text": "In batches sear the ribs, sausages and pork shoulder"
        },
        {
          "text": "Season each batch with salt and pepper"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Remove the meat and set aside"
        },
        {
          "text": "Add the onion, garlic and chilli to the pan"
        },
        {
          "text": "Pour in a little olive oil if it needs more"
        },
        {
          "text": "Season with salt and pepper and fry for 8 mins or until soft"
        },
        {
          "text": "step 3"
        },
        {
          "text": "Add the meat, bay leaves, white wine vinegar and drained beans"
        },
        {
          "text": "Cover with just enough water to cover, about 650ml"
        },
        {
          "text": "Bring to a boil and reduce the heat to a low simmer"
        },
        {
          "text": "Cover and cook for 2 hrs, or until the beans are soft and the meat is tender"
        },
        {
          "text": "If there is too much liquid in the pot take the lid off in the last hr"
        },
        {
          "text": "You can also use a slow cooker on the short method (4 hr) or make a quick version using a pressure cooker in batches for 30 mins each"
        },
        {
          "text": "Another method is to cook it in the oven for 3-4 hrs at 160C/140C fan/gas 3"
        },
        {
          "text": "step 4"
        },
        {
          "text": "Serve with rice, a sprinkle of parsley or coriander, hot pepper sauce and orange slices."
        }
      ],
