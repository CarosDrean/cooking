      ],
      "steps": [
        {
          "text": "Mix all dry ingredients in a large bowl (sugar, salt and instant yeast)"
        },
        {
          "text": "Mix with a large wooden spoon"
        },
        {
          "text": "Add shortening or lard and mix"
        },
        {
          "text": "Mix thoroughly with your hand"
        },
        {
          "text": "Add warm water and mix the dough until stiff"
        },
        {
          "text": "Add more flour so that dough doesn't stick"
        },
        {
          "text": "You can add dough onto a floured board to make sure that it's properly kneaded"
        },
        {
          "text": "Knead for approximately 8-10 minutes"
        },
        {
          "text": "Shape dough into a large round shape and cover to rest for 45 minutes"
        },
        {
          "text": "Knead dough again on a lightly floured surface (kneading is the most critical part of this recipe process"
        },
        {
          "text": "Shape dough into your desired bread designs and place on a baking sheet or bread pan"
        },
        {
          "text": "Let the breads rest for 25 minutes"
        },
        {
          "text": "Preheat oven at 375°F"
        },
        {
          "text": "Bake until golden brown"
        },
        {
          "text": "Instructions when using active yeast"
        },
        {
          "text": "Mix 3½ cups of warm water (115°F to 120°F), yeast and sugar"
        },
        {
          "text": "Add a pinch of salt and ½lb of sifted flour to the mixture"
        },
        {
          "text": "Stir the mixture with a wooden spoon"
        },
        {
          "text": "Set in a warm place for approximately one hour"
        },
        {
          "text": "Mixture should look foamy with bubbles"
        },
        {
          "text": "Sift the rest of the flour in a large bowl"
        },
        {
          "text": "Pour yeast mixture into the large bowl over the flour"
        },
        {
          "text": "Add shortening or lard and mix"
        },
        {
          "text": "Add more flour so that dough doesn't stick"
        },
        {
          "text": "You can add dough onto a floured board to make sure that it's properly kneaded"
        },
        {
          "text": "Knead for approximately 8-10 minutes"
        },
        {
          "text": "Shape dough into a large round shape and cover to rest for 45 minutes"
        },
        {
          "text": "Let the breads rest for 25 minutes"
        },
        {
          "text": "Preheat oven at 375°F"
        },
        {
          "text": "Bake until golden brown"
        }
