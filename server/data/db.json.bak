      "servings": 4,
      "ingredients": [
        {
          "name": "Water",
          "quantity": 1,
          "unit": "and 1/8 cup",
          "category": "despensa"
        },
        {
          "name": "Vegetable oil",
          "quantity": 2,
          "unit": "tblsp",
          "category": "despensa"
        },
        {
          "name": "Sugar",
          "quantity": 0.5,
          "unit": "teaspoon",
          "category": "despensa"
        },
        {
          "name": "Salt",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Flour",
          "quantity": 3,
          "unit": "Cups",
          "category": "granos"
        },
        {
          "name": "Yeast",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "Place ingredients in the pan of the bread machine in the order recommended by the manufacturer"
        },
        {
          "text": "Select Dough cycle; press Start"
        },
        {
          "text": "When the Dough cycle is almost complete, preheat the oven to 475 degrees F (245 degrees C)"
        },
        {
          "text": "Turn dough out onto a lightly floured surface"
        },
        {
          "text": "Divide into eight equal pieces and form into rounds"
        },
        {
          "text": "Cover the rounds with a damp cloth and let rest"
        },
        {
          "text": "Roll dough into thin flat circles, about 8 inches in diameter"
        },
        {
          "text": "Cook two at a time on preheated baking sheets or a baking stone until puffed up and golden brown, about 5 minutes"
        },
        {
          "text": "Repeat for remaining loaves."
        }
      ],
