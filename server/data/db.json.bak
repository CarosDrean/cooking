      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Put the cabbage in a heavy casserole dish, add the stock and cook over a low heat for about 50 mins, until tender"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Cut the soaked mushrooms into strips and save the soaking water"
        },
        {
          "text": "Heat the lard and fry the sausages and bacon, then scoop out, leaving the fat in the pan"
        },
        {
          "text": "Fry the onion in the same pan for 5-8 mins until lightly browned"
        },
        {
          "text": "step 3"
        },
        {
          "text": "Add the mushrooms and their liquid along with all the cooked meat, onions and prunes, then cover and cook for 20 mins"
        },
        {
          "text": "Add the spices, red wine and tomato purée and bring to a simmer, then cover and cook for 1 hr"
        },
        {
          "text": "Season well and leave to cool"
        },
        {
          "text": "Will keep covered and chilled for up to two days"
        },
        {
          "text": "Bigos improves in flavour over a couple of days"
        },
        {
          "text": "Leave to cool first"
        },
        {
          "text": "Reheat until piping hot before serving."
        }
