        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 20,
      "servings": 4,
      "ingredients": [
        {
          "name": "huevo",
          "quantity": 6,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "papa",
          "quantity": 500,
          "unit": "g",
          "category": "verduras"
        },
        {
          "name": "cebolla",
          "quantity": 1,
          "unit": "unidades",
          "category": "verduras"
        },
