      "id": "tmdb-53562",
      "title": "Breadfruit Tacos",
      "description": "Receta de cocina internacional (categoría: Side). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/dk70uv1784670127.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "internacional",
      "suitableFor": [
        "desayuno",
        "almuerzo"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Breadfruit",
          "quantity": 1,
          "unit": "unidades",
          "category": "frutas"
        },
        {
          "name": "Water",
          "quantity": 1,
          "unit": "pot",
          "category": "despensa"
        },
        {
          "name": "Codfish bulljaw",
          "quantity": 1,
          "unit": "As required",
          "category": "proteinas"
        },
        {
          "name": "Lettuce",
          "quantity": 1,
          "unit": "As required",
          "category": "verduras"
        },
        {
          "name": "Oil",
          "quantity": 1,
          "unit": "For frying",
          "category": "despensa"
        }
      ],
      "steps": [
        {
          "text": "Place a large pot of water to boil, add breadfruit, and let it cook for around 30 minutes"
        },
        {
          "text": "Remove breadfruit from pot and let it cool for a few minutes"
        },
        {
          "text": "Hold the breadfruit firmly and using a large sharp knife slice into thin rounds"
        },
        {
          "text": "Slice as many as you need"
        },
        {
          "text": "Then cut off skin and core (You may leave the core on if you like)"
        },
        {
          "text": "Gently fold to shape like a taco shell, use two toothpicks to hold it in place"
        },
        {
          "text": "Place on a large plate or tray and repeat this process for all breadfruit slices"
        },
        {
          "text": "Heat oil for deep frying, using a pair of tongs submerge breadfruit slices in pan,"
        },
        {
          "text": "You can guide slices with tongs if you need to"
        },
        {
          "text": "You can leave the small toothpicks in the taco shells and remove them after they're cooked"
        },
        {
          "text": "Or, you can do like I did"
        },
        {
          "text": "If your'e using larger toothpicks, you may need to remove them safely"
        },
        {
          "text": "Be very careful as you need to adjust it in the hot oil"
        },
        {
          "text": "Remove when golden brown"
        },
        {
          "text": "Set over tissue paper"
        },
        {
          "text": "Repeat this for the rest of the shells"
        },
        {
          "text": "Stuff the shell with your favorite filling"
        },
        {
          "text": "I chose codfish/ salt fish"
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
