      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Beef",
          "quantity": 500,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Cabbage",
          "quantity": 1,
