      "id": "tmdb-53272",
      "title": "Griddled flatbreads",
      "description": "Receta de Turkish (categoría: Side). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/8825lo1763815264.jpg",
      "source": "themealdb",
      "diets": [
        "vegano",
        "vegetariano",
        "sin-lactosa",
        "sin-lactosa"
      ],
      "cuisine": "turkish",
      "suitableFor": [
        "desayuno",
        "almuerzo"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Strong wholemeal flour",
          "quantity": 250,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Strong white bread flour",
          "quantity": 250,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Yeast",
          "quantity": 15,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Sugar",
          "quantity": 1,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Olive oil",
          "quantity": 2,
          "unit": "tablespoons",
          "category": "despensa"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Tip the flours into a food processor"
        },
        {
          "text": "Add the yeast, sugar and 1tsp salt, then mix well"
        },
        {
          "text": "Pour in 350ml warm water and the oil, then process to a soft dough"
        },
        {
          "text": "Mix for 1 min, then leave until doubled in size, about 1 hour"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Pulse the dough a couple of times just to knock out the air, then tip onto a floured surface"
        },
        {
          "text": "Cut the dough in half and roll out one half to a rectangle about 20 x 40cm"
        },
        {
          "text": "Trim the edges using a large sharp knife, then cut into eight 10cm squares"
        },
        {
          "text": "Line a large tray or two baking sheets with non-stick paper and arrange the bread rectangles over the tray in one layer"
        },
        {
          "text": "Repeat with the other half of the dough"
        },
        {
          "text": "Leave in a warm place for about 30 mins until the dough is just starting to rise"
        },
        {
          "text": "step 3"
        },
        {
          "text": "Place bread directly onto the BBQ racks and cook for a couple of mins until they puff up, then flip over and cook on the other side"
        },
        {
          "text": "Tip into a basket and serve with the dips."
        }
      ],
