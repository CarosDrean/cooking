    {
      "id": "tmdb-52895",
      "title": "English Breakfast",
      "description": "Receta de British (categoría: Breakfast). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/utxryw1511721587.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "british",
      "suitableFor": [
        "desayuno"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Sausages",
          "quantity": 2,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "Bacon",
          "quantity": 3,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "Mushrooms",
          "quantity": 2,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Tomatoes",
          "quantity": 2,
          "unit": "unidades",
          "category": "verduras"
        },
        {
          "name": "Black pudding",
          "quantity": 1,
          "unit": "Slice",
          "category": "otros"
        },
        {
          "name": "Eggs",
          "quantity": 2,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "Bread",
          "quantity": 1,
          "unit": "Slice",
          "category": "granos"
        }
      ],
      "steps": [
        {
          "text": "Heat the flat grill plate over a low heat, on top of 2 rings/flames if it fits, and brush sparingly with light olive oil"
        },
        {
          "text": "Cook the sausages first"
        },
        {
          "text": "Add the sausages to the hot grill plate/the coolest part if there is one and allow to cook slowly for about 15-20 minutes, turning occasionally, until golden"
        },
        {
          "text": "After the first 10 minutes, increase the heat to medium before beginning to cook the other ingredients"
        },
        {
          "text": "If you are struggling for space, completely cook the sausages and keep hot on a plate in the oven"
        },
        {
          "text": "Snip a few small cuts into the fatty edge of the bacon"
        },
        {
          "text": "Place the bacon straight on to the grill plate and fry for 2-4 minutes each side or until your preferred crispiness is reached"
        },
        {
          "text": "Like the sausages, the cooked bacon can be kept hot on a plate in the oven"
        },
        {
          "text": "For the mushrooms, brush away any dirt using a pastry brush and trim the stalk level with the mushroom top"
        },
        {
          "text": "Season with salt and pepper and drizzle over a little olive oil"
        },
        {
          "text": "Place stalk-side up on the grill plate and cook for 1-2 minutes before turning and cooking for a further 3-4 minutes"
        },
        {
          "text": "Avoid moving the mushrooms too much while cooking, as this releases the natural juices, making them soggy"
        },
        {
          "text": "For the tomatoes, cut the tomatoes across the centre/or in half lengthways if using plum tomatoes , and with a small, sharp knife remove the green 'eye'"
        },
        {
          "text": "Season with salt and pepper and drizzle with a little olive oil"
        },
        {
          "text": "Place cut-side down on the grill plate and cook without moving for 2 minutes"
        },
        {
          "text": "Gently turn over and season again"
        },
        {
          "text": "Cook for a further 2-3 minutes until tender but still holding their shape"
        },
        {
          "text": "For the black pudding, cut the black pudding into 3-4 slices and remove the skin"
        },
        {
          "text": "Place on the grill plate and cook for 1½-2 minutes each side until slightly crispy"
        },
        {
          "text": "For 'proper' fried bread it's best to cook it in a separate pan"
        },
        {
          "text": "Ideally, use bread that is a couple of days old"
        },
        {
          "text": "Heat a frying pan to a medium heat and cover the base with oil"
        },
        {
          "text": "Add the bread and cook for 2-3 minutes each side until crispy and golden"
        },
        {
          "text": "If the pan becomes too dry, add a little more oil"
        },
        {
          "text": "For a richer flavour, add a knob of butter after you turn the slice"
        },
        {
          "text": "For the fried eggs, break the egg straight into the pan with the fried bread and leave for 30 seconds"
        },
        {
          "text": "Add a good knob of butter and lightly splash/baste the egg with the butter when melted"
        },
        {
          "text": "Cook to your preferred stage, season and gently remove with a fish slice"
        },
        {
          "text": "Once all the ingredients are cooked, serve on warm plates and enjoy straight away with a good squeeze of tomato ketchup or brown sauce."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
    {
      "id": "tmdb-52965",
      "title": "Breakfast Potatoes",
      "description": "Receta de Canadian (categoría: Breakfast). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/1550441882.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "canadian",
      "suitableFor": [
        "desayuno"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Potatoes",
          "quantity": 3,
          "unit": "Medium",
          "category": "verduras"
        },
        {
          "name": "Olive oil",
          "quantity": 1,
          "unit": "tbs",
          "category": "despensa"
        },
        {
          "name": "Bacon",
          "quantity": 2,
          "unit": "strips",
          "category": "proteinas"
        },
        {
          "name": "Garlic clove",
          "quantity": 1,
          "unit": "Minced",
          "category": "verduras"
        },
        {
          "name": "Maple syrup",
          "quantity": 1,
          "unit": "tbs",
          "category": "otros"
        },
        {
          "name": "Parsley",
          "quantity": 1,
          "unit": "Garnish",
          "category": "otros"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "Pinch",
          "category": "condimentos"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "Pinch",
          "category": "verduras"
        },
        {
          "name": "Allspice",
          "quantity": 1,
          "unit": "To taste",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "Before you do anything, freeze your bacon slices that way when you're ready to prep, it'll be so much easier to chop!"
        },
        {
          "text": "Wash the potatoes and cut medium dice into square pieces"
        },
        {
          "text": "To prevent any browning, place the already cut potatoes in a bowl filled with water"
        },
        {
          "text": "In the meantime, heat 1-2 tablespoons of oil in a large skillet over medium-high heat"
        },
        {
          "text": "Tilt the skillet so the oil spreads evenly"
        },
        {
          "text": "Once the oil is hot, drain the potatoes and add to the skillet"
        },
        {
          "text": "Season with salt, pepper, and Old Bay as needed"
        },
        {
          "text": "Cook for 10 minutes, stirring the potatoes often, until brown"
        },
        {
          "text": "If needed, add a tablespoon more of oil"
        },
        {
          "text": "Chop up the bacon and add to the potatoes"
        },
        {
          "text": "The bacon will start to render and the fat will begin to further cook the potatoes"
        },
        {
          "text": "Toss it up a bit! The bacon will take 5-6 minutes to crisp"
        },
        {
          "text": "Once the bacon is cooked, reduce the heat to medium-low, add the minced garlic and toss"
        },
        {
          "text": "Season once more"
        },
        {
          "text": "Add dried or fresh parsley"
        },
        {
          "text": "Control heat as needed"
        },
        {
          "text": "Let the garlic cook until fragrant, about one minute"
        },
        {
          "text": "Just before serving, drizzle over the maple syrup and toss"
        },
        {
          "text": "Let that cook another minute, giving the potatoes a caramelized effect"
        },
        {
          "text": "Serve in a warm bowl with a sunny side up egg!"
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
