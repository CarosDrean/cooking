        },
        {
          "name": "Passata",
          "quantity": 500,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Chicken stock cube",
          "quantity": 1,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "Black olives",
          "quantity": 100,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Parsley",
          "quantity": 1,
          "unit": "Chopped",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "Heat the oil in a large flameproof casserole dish and stir-fry the mushrooms until they start to soften"
        },
        {
          "text": "Add the chicken legs and cook briefly on each side to colour them a little"
        },
        {
          "text": "Pour in the passata, crumble in the stock cube and stir in the olives"
        },
        {
          "text": "Season with black pepper – you shouldn’t need salt"
        },
        {
          "text": "Cover and simmer for 40 mins until the chicken is tender"
        },
        {
          "text": "Sprinkle with parsley and serve with pasta and a salad, or mash and green veg, if you like."
        }
