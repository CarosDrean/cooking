    {
      "id": "tmdb-53359",
      "title": "Beef Mandi",
      "description": "Receta de India (categoría: Beef). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/1nalo51765188375.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "india",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Basmati rice",
          "quantity": 1,
          "unit": "kg",
          "category": "granos"
        },
        {
          "name": "Beef stock",
          "quantity": 5,
          "unit": "Cups",
          "category": "proteinas"
        },
        {
          "name": "Onion",
          "quantity": 2,
          "unit": "medium",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 5,
          "unit": "chopped cloves",
          "category": "verduras"
        },
        {
          "name": "Green chilli",
          "quantity": 2,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Tomato",
          "quantity": 1,
          "unit": "small",
          "category": "verduras"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "Tsp",
          "category": "condimentos"
        },
        {
          "name": "Oil",
          "quantity": 3,
          "unit": "tablespoons",
          "category": "despensa"
        },
        {
          "name": "Turmeric powder",
          "quantity": 1.5,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Cardamom",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Cloves",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Bay leaf",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "1"
        },
        {
          "text": "Wash the beef and cut into large pieces"
        },
        {
          "text": "Season lightly with salt and turmeric"
        },
        {
          "text": "2"
        },
        {
          "text": "Heat ghee/oil in a large pot"
        },
        {
          "text": "Add sliced onions and sauté until light golden"
        },
        {
          "text": "3"
        },
        {
          "text": "Add garlic, green chilies, and tomato; cook until softened"
        },
        {
          "text": "4"
        },
        {
          "text": "Add the mandi spice mix: coriander, cumin, black pepper, cinnamon, cardamom, cloves, and bay leaves"
        },
        {
          "text": "5"
        },
        {
          "text": "Add beef pieces and stir on medium heat until the meat is well coated with spices"
        },
        {
          "text": "6"
        },
        {
          "text": "Pour in water or beef stock"
        },
        {
          "text": "Cover and simmer until beef is tender (about 1.5–2 hours depending on cut)"
        },
        {
          "text": "7"
        },
        {
          "text": "Remove beef carefully and set aside"
        },
        {
          "text": "Strain and measure the broth"
        },
        {
          "text": "8"
        },
        {
          "text": "Add washed, soaked basmati rice to the broth (usually 1 cup rice = 1.5–2 cups liquid)"
        },
        {
          "text": "Adjust seasoning and bring to a boil"
        },
        {
          "text": "9"
        },
        {
          "text": "Lower heat, cover, and cook the rice until fluffy"
        },
        {
          "text": "10"
        },
        {
          "text": "Place the beef pieces over the rice and steam on low heat for 10 minutes so flavors combine"
        },
        {
          "text": "11"
        },
        {
          "text": "Optional: For smoky flavor, place a small hot charcoal on foil in the pot, add 1 tsp butter/oil, immediately cover for 5 minutes"
        },
        {
          "text": "Remove coal before serving"
        },
        {
          "text": "12"
        },
        {
          "text": "Fluff rice and serve beef mandi with salad or chutney"
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
