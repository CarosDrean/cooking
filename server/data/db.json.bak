        {
          "name": "Dijon mustard",
          "quantity": 1,
          "unit": "tbsp",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Make 3 slashes on each of the drumsticks"
        },
        {
          "text": "Mix together the soy, honey, oil, tomato purée and mustard"
        },
        {
          "text": "Pour this mixture over the chicken and coat thoroughly"
        },
        {
          "text": "Leave to marinate for 30 mins at room temperature or overnight in the fridge"
        },
        {
          "text": "Heat oven to 200C/fan 180C/gas 6"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Tip the chicken into a shallow roasting tray and cook for 35 mins, turning occasionally, until the chicken is tender and glistening with the marinade."
        }
