      "steps": [
        {
          "text": "Heat the oven to 180C/350F/gas mark 4"
        },
        {
          "text": "Drain and rinse the soaked wheat, put it in a medium pan with lots of water, bring to a boil and simmer for an hour, until cooked"
        },
        {
          "text": "Drain and set aside"
        },
        {
          "text": "Season the lamb with a teaspoon of salt and some black pepper"
        },
        {
          "text": "Put one tablespoon of oil in a large, deep sauté pan for which you have a lid; place on a medium-high heat"
        },
        {
          "text": "Add some of the lamb – don't overcrowd the pan – and sear for four minutes on all sides"
        },
        {
          "text": "Transfer to a bowl, and repeat with the remaining lamb, adding oil as needed"
        },
        {
          "text": "Lower the heat to medium and add a tablespoon of oil to the pan"
        },
        {
          "text": "Add the shallots and fry for four minutes, until caramelised"
        },
        {
          "text": "Tip these into the lamb bowl, and repeat with the remaining vegetables until they are all nice and brown, adding more oil as you need it"
        },
        {
          "text": "Once all the vegetables are seared and removed from the pan, add the wine along with the sugar, herbs, a teaspoon of salt and a good grind of black pepper"
        },
        {
          "text": "Boil on a high heat for about three minutes"
        },
        {
          "text": "Tip the lamb, vegetables and whole wheat back into the pot, and add the stock"
        },
        {
          "text": "Cover and boil for five minutes, then transfer to the oven for an hour and a half"
        },
        {
          "text": "Remove the stew from the oven and check the liquid; if there is a lot, remove the lid and boil for a few minutes."
        }
      ],
