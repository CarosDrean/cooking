      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Eggs",
          "quantity": 12,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "Mayonnaise",
          "quantity": 7,
          "unit": "tablespoons",
          "category": "otros"
        },
        {
          "name": "Mustard",
          "quantity": 1,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "To taste",
          "category": "verduras"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "To taste",
          "category": "condimentos"
        },
        {
          "name": "Paprika",
          "quantity": 1,
          "unit": "Pinch",
          "category": "condimentos"
        },
        {
          "name": "Chives",
          "quantity": 1,
          "unit": "Garnish",
          "category": "otros"
        },
        {
          "name": "Black pepper",
          "quantity": 1,
          "unit": "Garnish",
          "category": "verduras"
        },
        {
          "name": "Codfish bulljaw",
          "quantity": 1,
          "unit": "Topping",
          "category": "proteinas"
        }
      ],
      "steps": [
        {
          "text": "Bring eggs to a boil for 15 minutes"
        },
        {
          "text": "Let eggs sit in the water for another 5"
        },
        {
          "text": "Run under cold water"
        },
        {
          "text": "let eggs further cool"
        },
        {
          "text": "Rest eggs"
        },
        {
          "text": "Peel eggs"
        },
        {
          "text": "Cut eggs in half and remove egg yolks, place them in bowl"
        },
        {
          "text": "Mash egg yolks in a bowl"
        },
        {
          "text": "Combine all ingredients except for chives and peppercorns"
        },
        {
          "text": "Put the mixture in a piping bag or plastic bag"
        },
        {
          "text": "Fill egg slices with the mixture"
        },
        {
          "text": "Add codfish on the wider side of the egg"
        },
        {
          "text": "Garnish with crushed peppercorn and chive"
        }
      ],
