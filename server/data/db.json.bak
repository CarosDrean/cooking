      "servings": 4,
      "ingredients": [
        {
          "name": "Olive oil",
          "quantity": 1,
          "unit": "tbs",
          "category": "despensa"
        },
        {
          "name": "Mushrooms",
          "quantity": 300,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Chicken legs",
          "quantity": 4,
