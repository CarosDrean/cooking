    {
      "id": "tmdb-52904",
      "title": "Beef Bourguignon",
      "description": "Receta de France (categoría: Beef). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/vtqxtu1511784197.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "france",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Goose fat",
          "quantity": 3,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Beef shin",
          "quantity": 600,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Bacon",
          "quantity": 100,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Challots",
          "quantity": 350,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Chestnut mushroom",
          "quantity": 250,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Garlic clove",
          "quantity": 2,
          "unit": "sliced",
          "category": "verduras"
        },
        {
          "name": "Bouquet garni",
          "quantity": 1,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Tomato puree",
          "quantity": 1,
          "unit": "tbs",
          "category": "verduras"
        },
        {
          "name": "Red wine",
          "quantity": 750,
          "unit": "ml",
          "category": "otros"
        },
        {
          "name": "Celeriac",
          "quantity": 600,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Olive oil",
          "quantity": 2,
          "unit": "tbs",
          "category": "despensa"
        },
        {
          "name": "Thyme",
          "quantity": 1,
          "unit": "sprigs of fresh",
          "category": "condimentos"
        },
        {
          "name": "Rosemary",
          "quantity": 1,
          "unit": "sprigs of fresh",
          "category": "condimentos"
        },
        {
          "name": "Bay leaf",
          "quantity": 2,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Cardamom",
          "quantity": 4,
          "unit": "unidades",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "Heat a large casserole pan and add 1 tbsp goose fat"
        },
        {
          "text": "Season the beef and fry until golden brown, about 3-5 mins, then turn over and fry the other side until the meat is browned all over, adding more fat if necessary"
        },
        {
          "text": "Do this in 2-3 batches, transferring the meat to a colander set over a bowl when browned"
        },
        {
          "text": "In the same pan, fry the bacon, shallots or pearl onions, mushrooms, garlic and bouquet garni until lightly browned"
        },
        {
          "text": "Mix in the tomato purée and cook for a few mins, stirring into the mixture"
        },
        {
          "text": "This enriches the bourguignon and makes a great base for the stew"
        },
        {
          "text": "Then return the beef and any drained juices to the pan and stir through"
        },
        {
          "text": "Pour over the wine and about 100ml water so the meat bobs up from the liquid, but isn’t completely covered"
        },
        {
          "text": "Bring to the boil and use a spoon to scrape the caramelised cooking juices from the bottom of the pan – this will give the stew more flavour"
        },
        {
          "text": "Heat oven to 150C/fan 130C/gas 2"
        },
        {
          "text": "Make a cartouche: tear off a square of foil slightly larger than the casserole, arrange it in the pan so it covers the top of the stew and trim away any excess foil"
        },
        {
          "text": "Then cook for 3 hrs"
        },
        {
          "text": "If the sauce looks watery, remove the beef and veg with a slotted spoon, and set aside"
        },
        {
          "text": "Cook the sauce over a high heat for a few mins until the sauce has thickened a little, then return the beef and vegetables to the pan"
        },
        {
          "text": "To make the celeriac mash, peel the celeriac and cut into cubes"
        },
        {
          "text": "Heat the olive oil in a large frying pan"
        },
        {
          "text": "Tip in the celeriac and fry for 5 mins until it turns golden"
        },
        {
          "text": "Season well with salt and pepper"
        },
        {
          "text": "Stir in the rosemary, thyme, bay and cardamom pods, then pour over 200ml water, enough to nearly cover the celeriac"
        },
        {
          "text": "Turn the heat to low, partially cover the pan and leave to simmer for 25-30 mins"
        },
        {
          "text": "After 25-30 mins, the celeriac should be soft and most of the water will have evaporated"
        },
        {
          "text": "Drain away any remaining water, then remove the herb sprigs, bay and cardamom pods"
        },
        {
          "text": "Lightly crush with a potato masher, then finish with a glug of olive oil and season to taste"
        },
        {
          "text": "Spoon the beef bourguignon into serving bowls and place a large spoonful of the celeriac mash on top"
        },
        {
          "text": "Garnish with one of the bay leaves, if you like."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
