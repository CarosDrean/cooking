      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Beef",
          "quantity": 0.5,
          "unit": "lb",
          "category": "proteinas"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "pinch",
          "category": "condimentos"
        },
        {
          "name": "Pepper",
