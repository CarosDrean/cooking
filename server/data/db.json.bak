    {
      "id": "tmdb-53370",
      "title": "Egg Foo Young",
      "description": "Receta de Chinese (categoría: Seafood). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/47y6ii1765658818.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "chinese",
      "suitableFor": [
        "desayuno"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Unsalted beef stock",
          "quantity": 1,
          "unit": "cup",
          "category": "proteinas"
        },
        {
          "name": "Soy sauce",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "condimentos"
        },
        {
          "name": "Shaoxing wine",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "otros"
        },
        {
          "name": "Oyster sauce",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "otros"
        },
        {
          "name": "Pepper",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "verduras"
        },
        {
          "name": "Cornstarch",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "granos"
        },
        {
          "name": "Water",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "despensa"
        },
        {
          "name": "Cornstarch",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "granos"
        },
        {
          "name": "Water",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "despensa"
        },
        {
          "name": "Egg",
          "quantity": 8,
          "unit": "large",
          "category": "proteinas"
        },
        {
          "name": "Kosher salt",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Sugar",
          "quantity": 0.25,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Spring onions",
          "quantity": 1,
          "unit": "unidades",
          "category": "verduras"
        },
        {
          "name": "Mung bean sprouts",
          "quantity": 1,
          "unit": "cup",
          "category": "granos"
        },
        {
          "name": "Shrimp",
          "quantity": 20,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "Vegetable oil",
          "quantity": 3,
          "unit": "Cups",
          "category": "despensa"
        },
        {
          "name": "Jasmine rice",
          "quantity": 2,
          "unit": "cups",
          "category": "granos"
        }
      ],
      "steps": [
        {
          "text": "Make the gravy:"
        },
        {
          "text": "In a small saucepan, add the beef stock, soy sauce, Shaoxing wine, oyster sauce, and white pepper powder over medium heat"
        },
        {
          "text": "Whisk together and bring to a simmer"
        },
        {
          "text": "Combine the cornstarch and water in a small bowl and whisk to dissolve"
        },
        {
          "text": "Add to the saucepan and whisk until the gravy thickens and coats the back of the spoon, 2 to 3 minutes"
        },
        {
          "text": "Cover the saucepan with a lid and keep it warm on the lowest possible heat"
        },
        {
          "text": "Make the egg foo young batter:"
        },
        {
          "text": "In a medium bowl, whisk together the cornstarch and water until dissolved"
        },
        {
          "text": "Add the eggs, salt, and sugar"
        },
        {
          "text": "Whisk until well combined and there are no more egg white clumps"
        },
        {
          "text": "Add the green onion, bean sprouts, and shrimp"
        },
        {
          "text": "Stir until everything is evenly coated"
        },
        {
          "text": "Fry the egg foo young:"
        },
        {
          "text": "Add the vegetable oil to a large wok; it should reach about 2 inches up the sides"
        },
        {
          "text": "Heat the oil over medium-high heat to 350°F, or until vigorous bubbles form around an inserted wooden chopstick"
        },
        {
          "text": "With a ladle, gently and slowly add 1/4 of the omelet batter"
        },
        {
          "text": "Egg foo young should immediately bubble and puff up like magic"
        },
        {
          "text": "Fry until golden brown and crispy on each side, about 2 minutes per side"
        },
        {
          "text": "If there are any light spots, use a ladle to gently baste it with hot oil"
        },
        {
          "text": "Tip"
        },
        {
          "text": "Egg foo young can be a bit tricky to flip"
        },
        {
          "text": "The easiest method is to put a tool in each hand (a spider, slotted spoon, tongs, and large chopsticks are all good candidates) and gently coax the omelet over, pulling up on one side and pushing down and around on the other"
        },
        {
          "text": "Remove the omelet and place it on a paper towel-lined baking sheet"
        },
        {
          "text": "Let it cool for 5 minutes"
        },
        {
          "text": "Meanwhile, repeat with the remaining batter to make 4 omelets"
        },
        {
          "text": "If needed, add more oil to the pan between batches"
        },
        {
          "text": "Serve and enjoy:"
        },
        {
          "text": "Plate each egg foo young over a bed of rice"
        },
        {
          "text": "Spoon the warm gravy over the top and serve immediately"
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
