      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Chicken",
          "quantity": 1,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "Basmati rice",
          "quantity": 2,
          "unit": "cups",
          "category": "granos"
        },
        {
          "name": "Water",
          "quantity": 4,
          "unit": "cups",
          "category": "despensa"
        },
        {
          "name": "Onion",
          "quantity": 1,
          "unit": "large",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 4,
          "unit": "cloves",
          "category": "verduras"
        },
        {
          "name": "Green chilli",
          "quantity": 2,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Salt",
          "quantity": 1.5,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Oil",
          "quantity": 3,
          "unit": "tablespoons",
          "category": "despensa"
        },
        {
          "name": "Turmeric powder",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "otros"
        },
        {
          "name": "Coriander",
          "quantity": 1,
          "unit": "teaspoon",
          "category": "otros"
        },
        {
          "name": "Cardamom",
          "quantity": 0.5,
          "unit": "tbsp",
          "category": "otros"
        },
        {
          "name": "Cloves",
          "quantity": 0.25,
          "unit": "teaspoon",
          "category": "otros"
        },
        {
          "name": "Cinnamon",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "tsp",
          "category": "verduras"
        },
        {
          "name": "Bay leaf",
          "quantity": 2,
          "unit": "unidades",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "1"
        },
        {
          "text": "Clean and cut the chicken; marinate briefly with salt, turmeric and a little oil"
        },
        {
          "text": "2"
        },
        {
          "text": "Rinse and soak basmati rice 20–30 minutes"
        },
        {
          "text": "3"
        },
        {
          "text": "In a large pot, heat ghee/oil"
        },
        {
          "text": "Fry chopped onion until golden"
        },
        {
          "text": "Add minced garlic and green chillies and fry 1–2 min"
        },
        {
          "text": "4"
        },
        {
          "text": "Add whole spices (cardamom, cloves, cinnamon, bay leaves) and ground spices (coriander, cumin)"
        },
        {
          "text": "Stir until fragrant"
        },
        {
          "text": "5"
        },
        {
          "text": "Add chicken pieces, brown lightly and add enough water/chicken stock to cover"
        },
        {
          "text": "Simmer until chicken is nearly cooked"
        },
        {
          "text": "6"
        },
        {
          "text": "Remove chicken; measure remaining liquid and add soaked rice"
        },
        {
          "text": "Bring to a boil, then reduce heat, cover and cook rice until almost done"
        },
        {
          "text": "7"
        },
        {
          "text": "Return the chicken to the rice pot on top, cover tightly and steam on low for 10–15 min so flavors meld"
        },
        {
          "text": "8"
        },
        {
          "text": "(Optional) For authentic smoky aroma: heat a small charcoal until red hot, place it on a small foil cup in the centre of the pot, add a tsp of butter/oil on the coal then cover immediately to trap smoke for 5–10 minutes"
        },
        {
          "text": "Remove coal"
        },
        {
          "text": "9"
        },
        {
          "text": "Garnish with fried onions, chopped coriander and serve with chutney or raita"
        }
      ],
