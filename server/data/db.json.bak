        "desayuno",
        "almuerzo"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Plum tomatoes",
          "quantity": 1,
          "unit": "lb",
          "category": "verduras"
        },
        {
          "name": "Vegetable oil",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "despensa"
        },
        {
          "name": "Eggs",
          "quantity": 5,
          "unit": "Large",
          "category": "proteinas"
        },
        {
          "name": "Sesame seed oil",
          "quantity": 1,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Chicken bouillon powder",
          "quantity": 2,
          "unit": "tsp",
          "category": "proteinas"
        },
        {
          "name": "Sugar",
          "quantity": 2,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Pepper",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "verduras"
        },
        {
          "name": "Salt",
          "quantity": 0.25,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Spring onions",
          "quantity": 1,
          "unit": "unidades",
          "category": "verduras"
        },
        {
          "name": "Jasmine rice",
          "quantity": 2,
          "unit": "cups",
          "category": "granos"
        }
      ],
      "steps": [
        {
          "text": "You can use chicken broth in place of the chicken bouillon powder"
        },
        {
          "text": "Add 1/4 cup of broth followed by 2 teaspoons of cornstarch dissolved in 1 tablespoPrepare the tomatoes:"
        },
        {
          "text": "Slice the tomatoes in half"
        },
        {
          "text": "Remove the tough stem from each half that connects to the vine"
        },
        {
          "text": "Cut each half into equal thirds (you’ll get 6 slices from each tomato)"
        },
        {
          "text": "Make the soft scrambled eggs:"
        },
        {
          "text": "In a cold, 8 to 10-inch nonstick skillet, add the vegetable oil and beaten eggs"
        },
        {
          "text": "Turn the heat to medium"
        },
        {
          "text": "Once a thin layer of eggs is just beginning to cook on the bottom, push the eggs in one direction to create layers of scrambled eggs"
        },
        {
          "text": "Cook, gently stirring the whole time, until the scramble eggs are mostly set but still slightly wet and shiny, 2 to 5 minutes"
        },
        {
          "text": "Remove the eggs to a plate and, if needed, wipe out the pan"
        },
        {
          "text": "Stir-fry the tomatoes and seasonings:"
        },
        {
          "text": "Add the sesame oil to the pan followed by the tomatoes and stir-fry over medium heat until the tomatoes are softened but not mushy, about 3 minutes"
        },
        {
          "text": "Add the chicken bouillon powder, sugar, and white pepper"
        },
        {
          "text": "Toss until combined and the sugar and bouillon have dissolved, about 1 minute"
        },
        {
          "text": "Add eggs, stir-fry, and garnish:"
        },
        {
          "text": "Add the eggs back to the pan with the tomatoes"
        },
        {
          "text": "Stir-fry for about 2 minutes to heat through and combine"
        },
        {
          "text": "Taste, adding salt only if needed"
        },
        {
          "text": "Sprinkle with the green onions and serve with steamed rice.on of water, plus salt to taste."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
    {
