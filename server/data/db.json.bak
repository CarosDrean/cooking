    {
      "id": "tmdb-53073",
      "title": "Eggplant Adobo",
      "description": "Receta de Filipino (categoría: Vegetarian). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/y7h0lq1683208991.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "filipino",
      "suitableFor": [
        "desayuno",
        "almuerzo"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Egg plants",
          "quantity": 1,
          "unit": "lb",
          "category": "proteinas"
        },
        {
          "name": "Sugar",
          "quantity": 2,
          "unit": "tbs",
          "category": "despensa"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "tsp",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 1,
          "unit": "whole",
          "category": "verduras"
        },
        {
          "name": "Olive oil",
          "quantity": 3,
          "unit": "tbs",
          "category": "despensa"
        },
        {
          "name": "Ground pork",
          "quantity": 4,
          "unit": "oz",
          "category": "proteinas"
        },
        {
          "name": "Rice vinegar",
          "quantity": 3,
          "unit": "tbs",
          "category": "granos"
        },
        {
          "name": "Soy sauce",
          "quantity": 2,
          "unit": "tbs",
          "category": "condimentos"
        },
        {
          "name": "Bay leaf",
          "quantity": 2,
          "unit": "unidades",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "1"
        },
        {
          "text": "Slice 1 lb"
        },
        {
          "text": "small Japanese or Italian eggplant (about 3) into quarters lengthwise, then cut crosswise into 2\"-wide pieces"
        },
        {
          "text": "Place in a medium bowl"
        },
        {
          "text": "Add 1 Tbsp"
        },
        {
          "text": "sugar, 1 tsp"
        },
        {
          "text": "Diamond Crystal or ½ tsp"
        },
        {
          "text": "Morton kosher salt, and ½ tsp"
        },
        {
          "text": "freshly ground black pepper"
        },
        {
          "text": "Toss to evenly coat eggplant and let sit at room temperature at least 20 minutes and up to 2 hours"
        },
        {
          "text": "2"
        },
        {
          "text": "Peel and thinly slice 8 garlic cloves"
        },
        {
          "text": "Add 3 Tbsp"
        },
        {
          "text": "vegetable oil and half of garlic to a medium Dutch oven or other heavy pot"
        },
        {
          "text": "Cook over medium-high heat, stirring constantly with a wooden spoon, until light golden and crisp, about 5 minutes"
        },
        {
          "text": "Using a slotted spoon, transfer garlic chips to a plate; season lightly with salt"
        },
        {
          "text": "3"
        },
        {
          "text": "Place 4 oz"
        },
        {
          "text": "ground pork in same pot and break up into small pieces with wooden spoon"
        },
        {
          "text": "Season with ¼ tsp"
        },
        {
          "text": "Diamond Crystal or Morton kosher salt and cook, undisturbed, until deeply browned underneath, about 5 minutes"
        },
        {
          "text": "Using a slotted spoon, transfer to another plate, leaving fat behind in the pot"
        },
        {
          "text": "4"
        },
        {
          "text": "Place eggplant on a clean kitchen towel and blot away any moisture the salt has drawn out"
        },
        {
          "text": "5"
        },
        {
          "text": "Working in batches and adding more oil if needed, cook eggplant in the same pot until lightly browned, about 3 minutes per side"
        },
        {
          "text": "Transfer to a plate with pork"
        },
        {
          "text": "6"
        },
        {
          "text": "Pour 1½ cups of water into the pot and scrape up browned bits from the bottom with a wooden spoon"
        },
        {
          "text": "Add remaining garlic, 3 Tbsp"
        },
        {
          "text": "coconut vinegar or unseasoned rice vinegar, 2 Tbsp"
        },
        {
          "text": "soy sauce, 2 bay leaves, 1 tsp"
        },
        {
          "text": "freshly ground black pepper, and remaining 1 Tbsp"
        },
        {
          "text": "sugar"
        },
        {
          "text": "Bring to a simmer, then return pork and eggplant to pot"
        },
        {
          "text": "Reduce heat to medium-low, partially cover, and simmer until eggplant is tender and silky and sauce is reduced by half, 20–25 minutes"
        },
        {
          "text": "Taste and season with more salt and pepper and add a little more sugar if needed"
        },
        {
          "text": "7"
        },
        {
          "text": "Top with garlic chips and serve with cooked white rice"
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
    {
      "id": "tmdb-52853",
      "title": "Chocolate Avocado Mousse",
      "description": "Receta de British (categoría: Dessert). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/uttuxy1511382180.jpg",
      "source": "themealdb",
      "diets": [
        "vegetariano",
        "sin-lactosa"
      ],
      "cuisine": "british",
      "suitableFor": [
        "desayuno",
        "almuerzo"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Banana",
          "quantity": 1,
          "unit": "unidades",
          "category": "frutas"
        },
        {
          "name": "Cacao",
          "quantity": 3,
          "unit": "tbsp",
          "category": "otros"
        },
        {
          "name": "Avocado",
          "quantity": 1,
          "unit": "unidades",
          "category": "verduras"
        },
        {
          "name": "Honey",
          "quantity": 2,
          "unit": "tblsp",
          "category": "despensa"
        },
        {
          "name": "Lemon juice",
          "quantity": 1,
          "unit": "tsp",
          "category": "frutas"
        },
        {
          "name": "Vanilla",
          "quantity": 1,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Water",
          "quantity": 2,
          "unit": "tbsp",
          "category": "despensa"
        },
        {
          "name": "Sea salt",
          "quantity": 1,
          "unit": "pinch",
          "category": "condimentos"
        }
      ],
      "steps": [
        {
          "text": "1"
        },
        {
          "text": "Blend all the mousse ingredients together in your food processor until smooth"
        },
        {
          "text": "Add the cacao powder first and, as you blend, have all the ingredients to hand in order to adjust the ratios slightly as the size of avocados and bananas varies so much"
        },
        {
          "text": "The perfect ratio in order to avoid the dish tasting too much of either is to use equal amounts of both"
        },
        {
          "text": "2"
        },
        {
          "text": "Taste and add a few drops of stevia if you feel you need more sweetness"
        },
        {
          "text": "3"
        },
        {
          "text": "Fill little cups or shot glasses with the mousse, sprinkle with the cacao powder or nibs and serve"
        },
        {
          "text": "Tip If you don’t have a frozen banana to hand you can just use a normal one and then chill the mousse before serving for a cooling dessert."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
