      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Egg plants",
          "quantity": 1,
          "unit": "large",
          "category": "proteinas"
        },
        {
          "name": "Breadcrumbs",
          "quantity": 1,
          "unit": "cup",
          "category": "granos"
        },
        {
          "name": "Sesame seed",
          "quantity": 50,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Eggs",
          "quantity": 2,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "To taste",
          "category": "condimentos"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "To taste",
          "category": "verduras"
        },
        {
          "name": "Vegetable oil",
          "quantity": 1,
          "unit": "For frying",
          "category": "despensa"
        }
      ],
      "steps": [
        {
          "text": "Slice eggplant into 1 cm (0.4-inch) slices"
        },
        {
          "text": "Place them in a bowl and sprinkle them with salt"
        },
        {
          "text": "allow them to sit for 30 minutes to render some of their liquid and bitterness"
        },
        {
          "text": "2"
        },
        {
          "text": "After 30 minutes wash eggplant slices from salt and pat dry with a kitchen towel"
        },
        {
          "text": "3"
        },
        {
          "text": "In a large bowl/plate place breadcrumbs and sesame seeds"
        },
        {
          "text": "In another bowl beat 2 eggs with pinch salt and pepper"
        },
        {
          "text": "4"
        },
        {
          "text": "Heal oil in a large skillet over high heat"
        },
        {
          "text": "5"
        },
        {
          "text": "Dip eggplant slices in egg, then in crumbs, and place in hot oil"
        },
        {
          "text": "Fry 2 to 3 minutes on each side, or until golden brown"
        },
        {
          "text": "Drain on a paper towel"
        }
      ],
