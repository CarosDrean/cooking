      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Yeast",
          "quantity": 2,
          "unit": "tubs",
          "category": "otros"
        },
        {
          "name": "Sugar",
          "quantity": 2,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Vegetable oil",
          "quantity": 2,
          "unit": "tablespoons",
          "category": "despensa"
        },
        {
          "name": "Flour",
          "quantity": 6,
          "unit": "cups",
          "category": "granos"
        },
        {
          "name": "Warm water",
          "quantity": 1,
          "unit": "cups",
          "category": "despensa"
        }
      ],
      "steps": [
        {
          "text": "Sift half the flour, mix with salt and yeast in a large mixing bowl, and slowly add warm water until the mixture forms a stiff dough"
        },
        {
          "text": "Add more sifted flour until you have a stiff enough dough to knead"
        },
        {
          "text": "Lightly flour the work surface, knead the dough for 10 minutes until it is smooth and elastic, and then place it in a greased bowl"
        },
        {
          "text": "Now place the bowl warmly for 40-50 minutes until it has doubled"
        },
        {
          "text": "You know the dough is ready when you poke a finger, and the indentation remains"
        },
        {
          "text": "Preheat oven to 425 degrees F or 220 degrees C"
        },
        {
          "text": "Now divide the dough into 12 equal portions, roll each into a fist size ball, and place on a greased baking sheet"
        },
        {
          "text": "Now place in a warm place again for a further 40 minutes or again until the dough has doubled in size"
        },
        {
          "text": "Now place in the oven’s center and bake for 25-30 minutes until golden brown rolls sound hollow when tapped."
        }
      ],
      "tips": [],
