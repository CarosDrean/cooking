          "name": "Vegetable oil",
          "quantity": 2,
          "unit": "tbs",
          "category": "despensa"
        },
        {
          "name": "Minced beef",
          "quantity": 500,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Onion",
          "quantity": 1,
          "unit": "chopped",
          "category": "verduras"
        },
        {
          "name": "Tomato puree",
          "quantity": 1,
          "unit": "tbls",
          "category": "verduras"
        },
        {
          "name": "Plain flour",
          "quantity": 1.5,
          "unit": "tbsp",
          "category": "granos"
        },
        {
          "name": "Mushrooms",
          "quantity": 75,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Beef stock",
          "quantity": 250,
          "unit": "ml",
          "category": "proteinas"
        },
        {
          "name": "Worcestershire sauce",
          "quantity": 1,
          "unit": "Dash",
          "category": "otros"
        },
        {
          "name": "Shortcrust pastry",
          "quantity": 400,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Egg yolks",
          "quantity": 1,
          "unit": "unidades",
          "category": "proteinas"
        }
      ],
      "steps": [
        {
          "text": "Preheat the oven to 200C/400F/Gas 6"
        },
        {
          "text": "Heat the oil in a deep frying pan and fry the beef mince for 4-5 minutes, breaking it up with a wooden spoon as it browns"
        },
        {
          "text": "Add the onion and cook for 2-3 minutes, then stir in the tomato purée and cook for 2-3 more minutes"
        },
        {
          "text": "Stir in the flour and cook for a further minute, then add the chopped mushrooms, the stout or beef stock and a couple of dashes of Worcestershire sauce"
        },
        {
          "text": "Bring to the boil, then reduce the heat, cover the pan with a lid and leave to simmer for 20 minutes"
        },
        {
          "text": "Set aside and leave to cool, then turn the meat mixture into a one litre pie dish"
        },
        {
          "text": "Roll out the pastry on a floured work surface until it is slightly larger than the pie dish"
        },
        {
          "text": "Gently drape the pastry over the dish, pressing firmly onto the edges"
        },
        {
          "text": "Trim, then shape the edges into a fluted shape"
        },
        {
          "text": "Cut some leaf shapes out of the pastry trimmings and decorate the top of the pie, sticking them to the pastry with the beaten egg yolk"
        },
        {
          "text": "Make three or four slits in the pastry to allow the steam to escape, then brush the pie with the rest of the beaten egg yolk and bake in the oven for 20-25 minutes, or until golden-brown"
        },
        {
          "text": "To serve, slice into wedges."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
    {
      "id": "tmdb-52920",
      "title": "Chicken Marengo",
      "description": "Receta de France (categoría: Chicken). Importada de TheMealDB.",
