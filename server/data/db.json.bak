      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Baby new potatoes",
          "quantity": 500,
          "unit": "g",
          "category": "verduras"
        },
        {
          "name": "Egg",
          "quantity": 4,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "Green beans",
          "quantity": 225,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Chorizo",
          "quantity": 225,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Garlic clove",
          "quantity": 1,
          "unit": "sliced",
          "category": "verduras"
        },
        {
          "name": "Sherry vinegar",
          "quantity": 2,
          "unit": "tbsp",
          "category": "condimentos"
        },
        {
          "name": "Parsley",
          "quantity": 2,
          "unit": "tbsp chopped",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Cook the potatoes in a large pan of boiling salted water for 12 mins, adding the eggs after 6 mins, and the beans for the final 2 mins"
        },
        {
          "text": "Drain everything and cool the eggs under cold running water"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Meanwhile fry chorizo slices for 1-2 mins, until beginning to crisp"
        },
        {
          "text": "Remove from the pan with a slotted spoon and set aside, leaving the oil from the chorizo in the pan"
        },
        {
          "text": "Add the garlic to the pan and cook gently for 1 min"
        },
        {
          "text": "step 3"
        },
        {
          "text": "Remove the pan from the heat, stir in the vinegar and parsley, then toss with the potatoes, beans, chorizo and seasoning"
        },
        {
