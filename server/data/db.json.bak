    {
      "title": "Tortilla española",
      "description": "La clásica tortilla de patatas y huevo, dorada por fuera y jugosa por dentro.",
      "emoji": "🍳",
      "diets": [
        "vegetariano",
        "sin-gluten",
        "alta-proteina"
      ],
      "cuisine": "española",
      "suitableFor": [
        "desayuno",
