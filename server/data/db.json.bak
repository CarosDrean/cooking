      ],
      "steps": [
        {
          "text": "Preheat the oven to 350 degrees F (175 degrees C)"
        },
        {
          "text": "Heat a large pot over medium heat"
        },
        {
          "text": "Add the bacon and kielbasa; cook and stir until the bacon has rendered its fat and sausage is lightly browned"
        },
        {
          "text": "Use a slotted spoon to remove the meat and transfer to a large casserole or Dutch oven"
        },
        {
          "text": "Coat the cubes of pork lightly with flour and fry them in the bacon drippings over medium-high heat until golden brown"
        },
        {
          "text": "Use a slotted spoon to transfer the pork to the casserole"
        },
        {
          "text": "Add the garlic, onion, carrots, fresh mushrooms, cabbage and sauerkraut"
        },
        {
          "text": "Reduce heat to medium; cook and stir until the carrots are soft, about 10 minutes"
        },
        {
          "text": "Do not let the vegetables brown"
        },
        {
          "text": "Deglaze the pan by pouring in the red wine and stirring to loosen all of the bits of food and flour that are stuck to the bottom"
        },
        {
          "text": "Season with the bay leaf, basil, marjoram, paprika, salt, pepper, caraway seeds and cayenne pepper; cook for 1 minute"
        },
        {
          "text": "Mix in the dried mushrooms, hot pepper sauce, Worcestershire sauce, beef stock, tomato paste and tomatoes"
        },
        {
          "text": "Heat through just until boiling"
        },
        {
          "text": "Pour the vegetables and all of the liquid into the casserole dish with the meat"
        },
        {
          "text": "Cover with a lid"
        },
        {
          "text": "Bake in the preheated oven for 2 1/2 to 3 hours, until meat is very tender."
        }
      ],
