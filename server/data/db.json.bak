      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "france",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Prawns",
          "quantity": 6,
          "unit": "large",
          "category": "otros"
        },
        {
          "name": "Olive oil",
          "quantity": 3,
          "unit": "tbs",
          "category": "despensa"
        },
        {
          "name": "Dry white wine",
          "quantity": 150,
          "unit": "ml",
          "category": "otros"
        },
        {
          "name": "Fish stock",
          "quantity": 200,
          "unit": "ml",
          "category": "proteinas"
        },
        {
          "name": "Fennel",
          "quantity": 1,
          "unit": "small finely diced",
          "category": "otros"
        },
        {
          "name": "Onion",
          "quantity": 1,
          "unit": "small finely diced",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 3,
          "unit": "cloves Chopped",
          "category": "verduras"
        },
        {
          "name": "Potatoes",
          "quantity": 1,
          "unit": "large",
          "category": "verduras"
        },
        {
          "name": "Orange",
          "quantity": 1,
          "unit": "unidades",
          "category": "frutas"
        },
        {
          "name": "Star anise",
          "quantity": 1,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Bay leaf",
          "quantity": 1,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Harissa spice",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Tomato puree",
          "quantity": 2,
          "unit": "tbs",
          "category": "verduras"
        },
        {
          "name": "Chopped tomatoes",
          "quantity": 400,
          "unit": "g",
          "category": "verduras"
        },
        {
          "name": "Mussels",
          "quantity": 1,
          "unit": "Handful",
          "category": "proteinas"
        },
        {
          "name": "White fish",
          "quantity": 200,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Thyme",
          "quantity": 2,
          "unit": "unidades",
          "category": "condimentos"
        },
        {
          "name": "Bread",
          "quantity": 1,
          "unit": "to serve",
          "category": "granos"
        }
      ],
      "steps": [
        {
          "text": "Twist the heads from the prawns, then peel away the legs and shells, but leave the tails intact"
        },
        {
          "text": "Devein each prawn"
        },
        {
          "text": "Fry the shells in 1 tbsp oil for 5 mins, until dark pink and golden in patches"
        },
        {
          "text": "Add the wine, boil down by two thirds, then pour in the stock"
        },
        {
          "text": "Strain into a jug, discarding the shells"
        },
        {
          "text": "Heat the rest of the oil in a deep frying pan or casserole"
        },
        {
          "text": "Add the fennel, onion and garlic, season, then cover and gently cook for 10 mins until softened"
        },
        {
          "text": "Meanwhile, peel the potato and cut into 2cm-ish chunks"
        },
        {
          "text": "Put into a pan of cold water, bring to the boil and cook for 5 mins until almost tender"
        },
        {
          "text": "Drain in a colander"
        },
        {
          "text": "Peel a strip of zest from the orange"
        },
        {
          "text": "Put the zest, star anise, bay and ½ tsp harissa into the pan"
        },
        {
          "text": "Fry gently, uncovered, for 5-10 mins, until the vegetables are soft, sweet and golden"
        },
        {
          "text": "Stir in the tomato purée, cook for 2 mins, then add the tomatoes and stock"
        },
        {
          "text": "Simmer for 10 mins until the sauce thickens slightly"
        },
        {
          "text": "Season to taste"
        },
        {
          "text": "The sauce can be made ahead, then reheated later in the day"
        },
        {
          "text": "Meantime, scrub the mussels or clams and pull away any stringy beards"
        },
        {
          "text": "Any that are open should be tapped sharply on the worktop – if they don’t close after a few seconds, discard them"
        },
        {
          "text": "Reheat the sauce if necessary, then stir the potato, chunks of fish and prawns very gently into the stew"
        },
        {
          "text": "Bring back to the boil, then cover and gently simmer for 3 mins"
        },
        {
          "text": "Scatter the mussels or clams over the stew, then cover and cook for 2 mins more or until the shells have opened wide"
        },
        {
          "text": "Discard any that remain closed"
        },
        {
          "text": "The chunks of fish should flake easily and the prawns should be pink through"
        },
        {
          "text": "Scatter with the thyme leaves"
        },
        {
          "text": "To make the quick rouille, stir the rest of the harissa through the mayonnaise"
        },
        {
          "text": "Serve the stew in bowls, topped with spoonfuls of rouille, which will melt into the sauce and enrich it"
        },
        {
          "text": "Have some good bread ready, as you’ll definitely want to mop up the juices."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
