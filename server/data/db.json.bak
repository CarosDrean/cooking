        },
        {
          "name": "Lime",
          "quantity": 1,
          "unit": "To serve",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Put the ginger, garlic, lemongrass, coriander and 1 chilli in a food processor, then pulse until puréed"
        },
        {
          "text": "Heat the oil in a pan over a low heat"
        },
        {
          "text": "Add the purée and cook for 5 mins"
        },
        {
          "text": "Stir in the beef, soy, five-spice, sugar and stock"
        },
        {
          "text": "Put on a lid and bring to the boil, then lower heat and simmer for 1 hr 15 mins"
        },
        {
          "text": "Remove the lid and cook for a further 15 mins until the beef is tender"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Just before serving, prepare noodles following pack instructions"
        },
        {
          "text": "Drain well, then divide between 2 bowls and spoon over the beef stew"
        },
        {
          "text": "Serve sprinkled with the remaining chilli and coriander leaves, with lime wedges for squeezing over."
        }
      ],
