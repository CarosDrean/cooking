  "recipes": [
    {
      "title": "Ensalada de quinoa y garbanzos",
      "description": "Quinoa esponjosa, garbanzos, pepino, tomate y un aderezo de limón. Fresca, completa y lista en minutos.",
      "emoji": "🥗",
      "diets": [
        "vegano",
        "sin-gluten",
        "alta-proteina",
        "sin-lactosa"
      ],
      "cuisine": "mediterranea",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 15,
      "servings": 2,
      "ingredients": [
        {
          "name": "quinoa",
          "quantity": 200,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "garbanzos cocidos",
          "quantity": 400,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "tomate",
          "quantity": 2,
          "unit": "unidades",
          "category": "verduras"
        },
        {
          "name": "pepino",
          "quantity": 1,
          "unit": "unidades",
          "category": "verduras"
        },
        {
          "name": "cebolla morada",
          "quantity": 1,
          "unit": "unidades",
          "category": "verduras"
        },
        {
          "name": "limón",
          "quantity": 1,
          "unit": "unidades",
          "category": "frutas"
        },
        {
          "name": "aceite de oliva",
          "quantity": 2,
          "unit": "cucharadas",
          "category": "despensa"
        },
        {
          "name": "comino",
          "quantity": 1,
          "unit": "cucharaditas",
          "category": "condimentos"
        },
        {
          "name": "perejil fresco",
          "quantity": 1,
          "unit": "puñados",
          "category": "verduras"
        },
        {
          "name": "sal",
          "quantity": 1,
          "unit": "cucharaditas",
          "category": "despensa"
        }
      ],
      "steps": [
        {
          "text": "Enjuaga la quinoa bajo agua fría y cuécela en 400 ml de agua con una pizca de sal durante 15 minutos.",
          "tip": "Enjuagar la quinoa elimina la saponina que la vuelve amarga."
        },
        {
          "text": "Deja reposar la quinoa tapada 5 minutos y espónjala con un tenedor.",
          "tip": "Reposar tapada hace que los granos queden sueltos, no pastosos."
        },
        {
          "text": "Pica el tomate, el pepino, la cebolla morada y el perejil."
        },
        {
          "text": "Mezcla el jugo de limón, el aceite, el comino y la sal en un bol pequeño.",
          "tip": "Emulsiona batiendo con un tenedor mientras agregas el aceite."
        },
        {
          "text": "Combina todo en un bol grande, mezcla con el aderezo y sirve tibio o frío."
        }
      ],
      "tips": [
        "Los garbanzos cocidos en lata van perfectos: escúrrelos y enjuágalos bien.",
        "Se conserva hasta 2 días en la nevera, ideal para meal-prep.",
        "Puedes sumarle aguacate o semillas para más saciedad."
      ],
      "nutrition": {
        "kcal": 420,
        "protein": 16,
        "carbs": 62,
        "fat": 12
      },
      "id": "r1",
      "source": "local",
      "image": "https://api.openverse.org/v1/images/b29ddf8d-092f-4a83-9596-b74f32afe9ae/thumb/"
    },
    {
      "title": "Pollo al horno con hierbas",
      "description": "Pechugas jugosas con romero, tomillo y limón, horneadas a la perfección con verduras de temporada.",
      "emoji": "🍗",
      "diets": [
        "sin-gluten",
        "alta-proteina",
        "sin-lactosa"
      ],
      "cuisine": "internacional",
      "suitableFor": [
