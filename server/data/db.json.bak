        "desayuno"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Potatoes",
          "quantity": 1,
          "unit": "kg",
          "category": "verduras"
        },
        {
          "name": "Paprika",
          "quantity": 3,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Olive oil",
          "quantity": 2,
          "unit": "teaspoons",
          "category": "despensa"
        },
        {
          "name": "Onion",
          "quantity": 2,
          "unit": "sliced",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 2,
          "unit": "cloves minced",
          "category": "verduras"
        },
        {
          "name": "Tinned tomatos",
          "quantity": 800,
          "unit": "g",
          "category": "verduras"
        },
        {
          "name": "Chicken",
          "quantity": 300,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Roasted pepper",
          "quantity": 140,
          "unit": "g",
          "category": "verduras"
        },
        {
          "name": "Green olives",
          "quantity": 1,
          "unit": "Handful",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Heat oven to 200C/fan 180C/gas 6"
        },
        {
          "text": "Boil the potatoes for 15-20 mins until tender"
        },
        {
          "text": "Drain, return to the pan, then mash with some seasoning and 2 tsp of the paprika"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Meanwhile, heat the oil in a large pan, then fry the onions and garlic for a few mins until softened"
        },
        {
          "text": "Stir in the remaining paprika for 1 min, add the tomatoes , then, bring to a simmer"
        },
        {
          "text": "Tip into a large ovenproof dish, then stir in the chicken, peppers, olives and some seasoning"
        },
        {
          "text": "step 3"
        },
        {
          "text": "Spoon over the mash, then bake for 15 mins until the mash is golden on top and the sauce is bubbling."
        }
      ],
