    {
      "id": "tmdb-53250",
      "title": "Vegan banh mi",
      "description": "Receta de Vietnamese (categoría: Vegan). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/sonirb1763782831.jpg",
      "source": "themealdb",
      "diets": [
        "vegano",
        "vegetariano",
        "sin-lactosa",
        "sin-lactosa"
      ],
      "cuisine": "vietnamese",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Raw vegetables",
          "quantity": 150,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Vegan white wine vinegar",
          "quantity": 3,
          "unit": "tablespoons",
          "category": "condimentos"
        },
        {
          "name": "Golden caster sugar",
          "quantity": 1,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Baguette",
          "quantity": 1,
          "unit": "large",
          "category": "otros"
        },
        {
          "name": "Hummus",
          "quantity": 100,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Tempeh",
          "quantity": 175,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Coriander",
          "quantity": 1,
          "unit": "Handful",
          "category": "otros"
        },
        {
          "name": "Mint",
          "quantity": 1,
          "unit": "Handful",
          "category": "otros"
        },
        {
          "name": "Hotsauce",
          "quantity": 1,
          "unit": "To serve",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Put the shredded veg in a bowl and add the vinegar, sugar and 1 tsp salt"
        },
        {
          "text": "Toss everything together, then set aside to pickle quickly while you prepare the rest of the sandwich"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Heat oven to 180C/160C fan/gas 4"
        },
        {
          "text": "Cut the baguette into four, then slice each piece horizontally in half"
        },
        {
          "text": "Put the baguette pieces in the oven for 5 mins until lightly toasted and warm"
        },
        {
          "text": "Spread each piece with a layer of hummus, then top four pieces with the tempeh slices and pile the pickled veg on top"
        },
        {
          "text": "To serve, sprinkle over the herbs and squeeze over some hot sauce, then top with the other baguette pieces to make sandwiches."
        }
      ],
      "tips": [],
