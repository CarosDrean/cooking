          "quantity": 200,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Ginger",
          "quantity": 1,
          "unit": "pinch",
          "category": "otros"
        },
        {
          "name": "Harissa spice",
          "quantity": 2,
          "unit": "tblsp",
          "category": "otros"
        },
        {
          "name": "Dried apricots",
          "quantity": 10,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Chickpeas",
          "quantity": 220,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Couscous",
          "quantity": 200,
          "unit": "g",
          "category": "otros"
