      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Onions",
          "quantity": 2,
          "unit": "finely chopped",
          "category": "verduras"
        },
        {
          "name": "Red pepper",
          "quantity": 1,
          "unit": "Diced",
          "category": "verduras"
        },
        {
          "name": "Coriander",
          "quantity": 1,
          "unit": "Small bunch",
          "category": "otros"
        },
        {
          "name": "Red chilli",
          "quantity": 1,
          "unit": "small",
          "category": "otros"
        },
        {
          "name": "Garlic",
          "quantity": 3,
          "unit": "cloves",
          "category": "verduras"
        },
        {
          "name": "Dry white wine",
          "quantity": 400,
          "unit": "ml",
          "category": "otros"
        },
        {
          "name": "Saffron",
          "quantity": 1,
          "unit": "Pinch",
          "category": "otros"
        },
        {
          "name": "Bay leaf",
          "quantity": 1,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Potatoes",
          "quantity": 300,
          "unit": "g",
          "category": "verduras"
        },
        {
          "name": "Plum tomatoes",
          "quantity": 400,
          "unit": "g",
          "category": "verduras"
        },
        {
          "name": "Cod",
          "quantity": 600,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Squid",
          "quantity": 300,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Tiger prawns",
          "quantity": 8,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Clams",
          "quantity": 500,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Mussels",
          "quantity": 500,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Baguette",
          "quantity": 1,
          "unit": "sliced",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "STEP 1"
        },
        {
          "text": "Heat a drizzle of oil in a large, deep-sided frying pan, and fry the onion and pepper on a medium heat until softened but not browned"
        },
        {
          "text": "Finely chop the coriander stalks (keep the leaves for later), and add to the pan with the chilli and chopped garlic"
        },
        {
          "text": "Fry for another few minutes"
        },
        {
          "text": "Add the wine, saffron and bay leaf and let it simmer until reduced by half"
        },
        {
          "text": "STEP 2"
        },
        {
          "text": "Add the potatoes, tomatoes, and 300ml water and bring to a gentle boil"
        },
        {
          "text": "Break up the tomatoes with a spoon on the side of the pan and simmer for 20-25 minutes until the potatoes are just tender, and the tomatoes have broken down"
        },
        {
          "text": "STEP 3"
        },
        {
          "text": "Season well, then gently push the fish into the sauce, and arrange the squid, prawns, clams and mussels on the surface"
        },
        {
          "text": "Put the lid on and cook for 6-8 minutes until the mussel and clam shells have opened, the prawns are cooked and the fish is flaky"
        },
        {
          "text": "Toast the bread, rub lightly with the halved garlic clove and drizzle with olive oil"
        },
        {
          "text": "Serve the stew scatted with chopped coriander leaves, and the toasts for dunking."
        }
      ],
