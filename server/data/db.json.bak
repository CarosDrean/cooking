    {
      "id": "tmdb-53057",
      "title": "Traditional Croatian Goulash",
      "description": "Receta de Croatian (categoría: Beef). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/n1hcou1628770088.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "croatian",
      "suitableFor": [
        "desayuno",
        "almuerzo"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Beef",
          "quantity": 500,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Onions",
          "quantity": 2,
          "unit": "chopped",
          "category": "verduras"
        },
        {
          "name": "Carrots",
          "quantity": 2,
          "unit": "chopped",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 2,
          "unit": "cloves",
          "category": "verduras"
        },
        {
          "name": "Bay leaf",
          "quantity": 2,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Red wine",
          "quantity": 200,
          "unit": "ml",
          "category": "otros"
        },
        {
          "name": "Water",
          "quantity": 2,
          "unit": "Litres",
          "category": "despensa"
        },
        {
          "name": "Mustard",
          "quantity": 3,
          "unit": "tbs",
          "category": "otros"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "tbsp",
          "category": "condimentos"
        },
        {
          "name": "Pepper",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "verduras"
        },
        {
          "name": "Paprika",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Vegetable oil",
          "quantity": 2,
          "unit": "tbs",
          "category": "despensa"
        }
      ],
      "steps": [
        {
          "text": "Clean the meat from the veins if there are some and cut it into smaller pieces, 3 × 3 cm"
        },
        {
          "text": "Marinate the meat in the mustard and spices and let it sit in the refrigerator for one hour"
        },
        {
          "text": "Heat one tablespoon of pork fat or vegetable oil in a pot and fry the meat on all sides until it gets browned"
        },
        {
          "text": "Once the meat is cooked, transfer it to a plate and add another tablespoon of fat to the pot"
        },
        {
          "text": "Cut the onions very fine, peel the carrots and shred it using a grater"
        },
        {
          "text": "Cook the onions and carrots over low heat for 15 minutes"
        },
        {
          "text": "You can salt the vegetables a little to make them soften faster"
        },
        {
          "text": "Once the vegetables have browned and become slightly mushy, add the meat and bay leaves and garlic"
        },
        {
          "text": "Pour over with wine and simmer for 10-15 minutes to allow the alcohol to evaporate"
        },
        {
          "text": "Now is the right time to add 2/3 the amount of liquid"
        },
        {
          "text": "Cover the pot and cook over low heat for an hour, stirring occasionally"
        },
        {
          "text": "After the first hour, pour over the rest of the water or stock and cook for another 30-45 minutes"
        },
        {
          "text": "Allow the stew to cool slightly and serve it with a sprinkle of chopped parsley and few slices of fresh hot pepper if you like to spice it up a bit"
        },
        {
          "text": "Slice ​​some fresh bread, season the salad and simply enjoying these wonderful flavors"
        }
      ],
