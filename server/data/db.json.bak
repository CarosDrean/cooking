        },
        {
          "name": "limón",
          "quantity": 1,
          "unit": "unidades",
          "category": "frutas"
        },
        {
          "name": "romero seco",
          "quantity": 1,
          "unit": "cucharaditas",
          "category": "condimentos"
        },
        {
          "name": "tomillo seco",
          "quantity": 1,
          "unit": "cucharaditas",
          "category": "condimentos"
        },
        {
          "name": "aceite de oliva",
          "quantity": 3,
          "unit": "cucharadas",
          "category": "despensa"
        },
        {
          "name": "sal y pimienta",
          "quantity": 1,
          "unit": "cucharaditas",
          "category": "despensa"
        }
      ],
      "steps": [
        {
          "text": "Precalienta el horno a 200 °C y engrasa una bandeja con aceite."
        },
        {
          "text": "Corta las papas en gajos y las zanahorias en rodajas gruesas."
        },
        {
          "text": "Mezcla las verduras con aceite, sal, pimienta, romero y tomillo; extiéndelas en la bandeja.",
          "tip": "No amontones las verduras o se cocerán al vapor en vez de dorarse."
        },
        {
          "text": "Coloca las pechugas encima, unta con aceite y el jugo de medio limón, y sazona.",
          "tip": "Secar las pechugas con papel de cocina antes de sazonar ayuda a dorarlas."
        },
        {
          "text": "Hornea 30-35 minutos hasta que el pollo alcance 74 °C en el centro."
        },
        {
          "text": "Deja reposar 5 minutos antes de servir con rodajas de limón."
        }
      ],
      "tips": [
        "Un termómetro de cocina evita que el pollo quede seco.",
        "Las sobras se pueden usar para ensaladas al día siguiente.",
        "Si usas hierbas frescas, triplica la cantidad."
      ],
