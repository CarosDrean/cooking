        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Beef stock",
          "quantity": 1,
          "unit": "L",
          "category": "proteinas"
        },
        {
          "name": "Onion",
          "quantity": 1,
          "unit": "large",
          "category": "verduras"
        },
        {
          "name": "Ginger",
          "quantity": 1,
          "unit": "Large Chopped",
          "category": "otros"
        },
        {
          "name": "Cinnamon stick",
          "quantity": 1,
          "unit": "unidades",
          "category": "condimentos"
        },
        {
          "name": "Star anise",
          "quantity": 2,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Coriander seeds",
          "quantity": 1,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Cloves",
          "quantity": 0.5,
          "unit": "teaspoon",
          "category": "otros"
        },
        {
          "name": "Sirloin steak",
          "quantity": 225,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Palm sugar",
          "quantity": 1,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Fish sauce",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "proteinas"
        },
        {
          "name": "Soy sauce",
          "quantity": 1.5,
          "unit": "tbsp",
          "category": "condimentos"
        },
        {
          "name": "Rice noodles",
          "quantity": 200,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Spring onions",
          "quantity": 2,
          "unit": "sliced",
          "category": "verduras"
        },
        {
          "name": "Birds-eye chillies",
          "quantity": 1,
          "unit": "small",
          "category": "otros"
        },
        {
          "name": "Basil",
          "quantity": 1,
          "unit": "Handful",
          "category": "otros"
        },
        {
          "name": "Coriander",
          "quantity": 1,
          "unit": "Handful",
          "category": "otros"
        },
        {
          "name": "Lime",
          "quantity": 1,
          "unit": "unidades",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Tip the beef stock along with 500ml of water into a large saucepan"
        },
        {
          "text": "Sit the onion and ginger in a frying pan over a high heat and char on all sides, around 3-5 mins (you can also do this under your grill)"
        },
        {
          "text": "Once charred, add to the beef stock"
        },
        {
          "text": "In the same pan, toast the spices for 2-3 mins and once they begin to smell fragrant, add them to the beef stock as well"
        },
        {
          "text": "Bring the stock to the boil, then turn to a simmer and cook for 30mins before straining"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Meanwhile, cut the fat from the steak and wrap in cling film, then put into the freezer for 15 mins – this will make your steak really easy to slice! Slice it thinly, then cover with cling film again and pop into the fridge"
        },
        {
          "text": "step 3"
        },
        {
          "text": "Taste the beef stock and use the palm sugar, fish sauce and soy to season"
        },
        {
          "text": "Cook the noodles according to package instructions and split between two bowls, topping each with the sliced beef"
        },
        {
          "text": "Bring the stock to the boil and then pour into the bowls (the heat will cook the beef)"
        },
        {
          "text": "Top each with the spring onions, chilli slices and herbs"
        },
        {
          "text": "Serve with the lime wedges to squeeze over."
        }
      ],
