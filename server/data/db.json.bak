        },
        {
          "name": "Parma ham",
          "quantity": 6,
          "unit": "slices",
          "category": "proteinas"
        },
        {
          "name": "Puff pastry",
          "quantity": 500,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Flour",
          "quantity": 1,
          "unit": "Dusting",
          "category": "granos"
        },
        {
          "name": "Egg yolks",
          "quantity": 2,
          "unit": "Beaten",
          "category": "proteinas"
        }
      ],
      "steps": [
        {
          "text": "Put the mushrooms into a food processor with some seasoning and pulse to a rough paste"
        },
        {
          "text": "Scrape the paste into a pan and cook over a high heat for about 10 mins, tossing frequently, to cook out the moisture from the mushrooms"
        },
        {
          "text": "Spread out on a plate to cool"
        },
        {
          "text": "Heat in a frying pan and add a little olive oil"
        },
        {
          "text": "Season the beef and sear in the hot pan for 30 secs only on each side"
        },
        {
          "text": "(You don't want to cook it at this stage, just colour it)"
        },
        {
          "text": "Remove the beef from the pan and leave to cool, then brush all over with the mustard"
        },
        {
          "text": "Lay a sheet of cling film on a work surface and arrange the Parma ham slices on it, in slightly overlapping rows"
        },
        {
          "text": "With a palette knife, spread the mushroom paste over the ham, then place the seared beef fillet in the middle"
        },
        {
          "text": "Keeping a tight hold of the cling film from the edge, neatly roll the Parma ham and mushrooms around the beef to form a tight barrel shape"
        },
        {
          "text": "Twist the ends of the cling film to secure"
        },
        {
          "text": "Chill for 15-20 mins to allow the beef to set and keep its shape"
        },
        {
          "text": "Roll out the puff pastry on a floured surface to a large rectangle, the thickness of a £1 coin"
        },
        {
          "text": "Remove the cling film from the beef, then lay in the centre"
        },
        {
          "text": "Brush the surrounding pastry with egg yolk"
        },
        {
          "text": "Fold the ends over, the wrap the pastry around the beef, cutting off any excess"
        },
        {
          "text": "Turn over, so the seam is underneath, and place on a baking sheet"
        },
        {
          "text": "Brush over all the pastry with egg and chill for about 15 mins to let the pastry rest"
        },
        {
          "text": "Heat the oven to 200C, 400F, gas 6"
        },
        {
          "text": "Lightly score the pastry at 1cm intervals and glaze again with beaten egg yolk"
        },
        {
          "text": "Bake for 20 minutes, then lower the oven setting to 180C, 350F, gas 4 and cook for another 15 mins"
        },
        {
          "text": "Allow to rest for 10-15 mins before slicing and serving with the side dishes of your choice"
        },
        {
          "text": "The beef should still be pink in the centre when you serve it."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
