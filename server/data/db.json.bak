      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Lard",
          "quantity": 60,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Water",
          "quantity": 340,
          "unit": "g",
          "category": "despensa"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "All purpose flour",
          "quantity": 600,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Tomato",
          "quantity": 3,
          "unit": "unidades",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 1,
          "unit": "clove",
          "category": "verduras"
        },
        {
          "name": "Red onions",
          "quantity": 1,
          "unit": "large",
          "category": "verduras"
        },
        {
          "name": "Spring onions",
          "quantity": 1,
          "unit": "Bunch",
          "category": "verduras"
        },
        {
          "name": "Sirloin steak",
          "quantity": 750,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Dried oregano",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "condimentos"
        },
        {
          "name": "Paprika",
          "quantity": 1,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Red pepper flakes",
          "quantity": 1,
          "unit": "tsp",
          "category": "verduras"
        },
        {
          "name": "Parsley",
          "quantity": 1,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "To taste",
          "category": "condimentos"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "To taste",
          "category": "verduras"
        },
        {
          "name": "Egg",
          "quantity": 3,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "Egg wash",
          "quantity": 1,
          "unit": "Splash",
          "category": "proteinas"
        },
        {
          "name": "Chimichurri sauce",
          "quantity": 1,
          "unit": "Drizzle",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "For the dough place lard, warm water and salt in a large kneading bowl and stir"
        },
        {
          "text": "Add flour and oregano and either knead five miutes by hand or with the kneading function of your machine"
        },
        {
          "text": "Let rest covered for at least half an hour or overnight in the fridge"
        },
        {
          "text": "2"
        },
        {
          "text": "For the filling place tomatoes for about 30 seconds in boiling water, then cool with cold water and peel of skin and cut into cubes"
        },
        {
          "text": "Press garlic through garlic press, cut onions into cubes"
        },
        {
          "text": "Simmer garlic and onions in some olive oil until translucent"
        },
        {
          "text": "Take out onions and garlic and brown the meat at high heat from all sides"
        },
        {
          "text": "Season with all herbs and add the onions, garlic and tomatoes"
        },
        {
          "text": "Let simmer for a few minutes, add salt, pepper and additional spices to taste"
        },
        {
          "text": "You can prepare the meat the night before, chill in fridge if doing so"
        },
        {
          "text": "Boil eggs and also cut into cubes and mix with prepared meat"
        },
        {
          "text": "3"
        },
        {
          "text": "Cut dough into half and roll out one half thinnly on floured surface"
        },
        {
          "text": "Cut out circles about 12-15cm in diameter"
        },
        {
          "text": "Mine have a diameter of 12.5 cm"
        },
        {
          "text": "Place about 2-4 teaspoons of filling on one circle, put a bit of water all around the edges and fold over the other half so that you get half moons"
        },
        {
          "text": "Be sure to seal the edges with a fork"
        },
        {
          "text": "Repeat until you have no dough and filling left"
        },
        {
          "text": "4"
        },
        {
          "text": "Meanwhile preheat oven to 200 degrees Celsius"
        },
        {
          "text": "Brush empanadas with egg wash and bake about 8 empanadas on a baking sheet lined with parchment paper for about 25min or until golden"
        },
        {
          "text": "Serve warm with chimichurri sauce."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
    {
      "id": "tmdb-53112",
      "title": "Kenyan Beef Curry",
      "description": "Receta de Kenyan (categoría: Beef). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/lqampv1762325397.jpg",
      "source": "themealdb",
      "diets": [
        "vegano",
        "vegetariano",
        "sin-lactosa",
        "sin-lactosa"
      ],
      "cuisine": "kenyan",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Water",
          "quantity": 4,
          "unit": "cups",
          "category": "despensa"
        },
        {
          "name": "Sirloin steak tips",
          "quantity": 2,
          "unit": "Lbs",
          "category": "otros"
        },
        {
          "name": "Garlic clove",
          "quantity": 4,
          "unit": "unidades",
          "category": "verduras"
        },
        {
          "name": "Ground ginger",
          "quantity": 2,
          "unit": "teaspoons",
          "category": "otros"
        },
        {
          "name": "Oil",
          "quantity": 2,
          "unit": "tblsp",
          "category": "despensa"
        },
        {
          "name": "Red onions",
          "quantity": 2,
          "unit": "medium",
          "category": "verduras"
        },
        {
          "name": "Tomato",
          "quantity": 4,
          "unit": "unidades",
          "category": "verduras"
        },
        {
          "name": "Paprika",
          "quantity": 2,
          "unit": "tblsp",
          "category": "condimentos"
        },
        {
          "name": "Black pepper",
          "quantity": 0.5,
          "unit": "teaspoon",
          "category": "verduras"
        },
        {
          "name": "Curry powder",
          "quantity": 2,
          "unit": "teaspoons",
          "category": "condimentos"
        },
        {
          "name": "Tomato puree",
          "quantity": 4,
          "unit": "tablespoons",
          "category": "verduras"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "Dash",
          "category": "condimentos"
        },
        {
          "name": "Chilli",
          "quantity": 1,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Cilantro",
          "quantity": 1,
          "unit": "Leaves",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "Bring the 4 cups of water to a boil in a Dutch oven or soup pot"
        },
        {
          "text": "Add the beef, garlic, and ginger, and stir well"
        },
        {
          "text": "Bring to a gentle simmer, cover, and cook, stirring occasionally, for 20 minutes"
        },
        {
          "text": "If you get any foamy scum on the top, not to worry, simply spoon it away or stir it back in"
        },
        {
          "text": "Remove from the heat, and drain, but reserve the excess water for later"
        },
        {
          "text": "Return the pot or Dutch oven to medium heat with the 2 tablespoons of cooking oil"
        },
        {
          "text": "Once the oil is shimmering, add the onions and cook, stirring occasionally, until softened, 5 to 7 minutes"
        },
        {
          "text": "Add the tomatoes to the onions, and continue cooking, stirring occasionally, until the tomatoes are falling apart, 3 to 5 minutes"
        },
        {
          "text": "Add the drained beef to the tomato and onion mixture, and stir well"
        },
        {
          "text": "Continue cooking over medium heat for 5 minutes, stirring occasionally"
        },
        {
          "text": "Add the paprika, pepper, curry powder, tomato paste, and salt to taste, and stir well"
        },
        {
          "text": "Add back the excess water that was used for cooking the beef, along with enough extra water to cover"
        },
        {
          "text": "Bring to a boil, reduce heat, and simmer, uncovered, stirring occasionally, for about 1 hour, or until the meat is tender and the sauce is thickened"
        },
        {
          "text": "Add additional water if your beef curry begins to dry and stick, or if would like your curry to have more of a soupy consistency"
        },
        {
          "text": "When the beef curry is ready, remove from the heat, give it a taste, and adjust the seasonings as desired"
        },
        {
          "text": "Garnish with fresh chilis and cilantro."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
    {
      "id": "tmdb-53367",
      "title": "Chicken Fried Rice",
      "description": "Receta de Chinese (categoría: Chicken). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/wuyd2h1765655837.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "chinese",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Chicken thighs",
          "quantity": 1,
          "unit": "lb",
          "category": "proteinas"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Canola oil",
          "quantity": 3,
          "unit": "tablespoons",
          "category": "despensa"
        },
        {
          "name": "Egg",
          "quantity": 3,
          "unit": "Large",
          "category": "proteinas"
        },
        {
          "name": "Onion",
          "quantity": 0.67,
          "unit": "Cup",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 2,
          "unit": "cloves minced",
          "category": "verduras"
        },
        {
          "name": "Ground ginger",
          "quantity": 2,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Carrots",
          "quantity": 1,
          "unit": "large",
          "category": "verduras"
        },
        {
          "name": "Peas",
          "quantity": 0.67,
          "unit": "Cup",
          "category": "otros"
        },
        {
          "name": "Jasmine rice",
          "quantity": 4,
          "unit": "cups",
          "category": "granos"
        },
        {
          "name": "Scallions",
          "quantity": 2,
          "unit": "sliced",
          "category": "otros"
        },
        {
          "name": "Chinese five spice powder",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Soy sauce",
          "quantity": 2.5,
          "unit": "tbsp",
          "category": "condimentos"
        },
        {
          "name": "Sesame seed oil",
          "quantity": 1,
          "unit": "tsp",
          "category": "despensa"
        }
      ],
      "steps": [
        {
          "text": "Fried rice is best made with leftover rice that's at least a day old"
        },
        {
          "text": "Otherwise it becomes gummy in the skillet"
        },
        {
          "text": "If you don’t have any leftover rice from the night before, cook a batch of rice and spread it on a large baking sheet or several large plates"
        },
        {
          "text": "Let the rice dry out for about 1 to 2 hours before using it for fried rice"
        },
        {
          "text": "Rice sticks to the pan very easily, so make sure to use a wok or pan that doesn’t have a sticky surface"
        },
        {
          "text": "I usually cook stir-fries in my seasoned carbon steel wok, but cast iron or nonstick pans work well, too"
        },
        {
          "text": "You might need to add a little more oil if things aren’t releasing easily"
        },
        {
          "text": "Prepare the chicken:"
        },
        {
          "text": "Chop the chicken into small 1/4-inch to 1/2-inch cubes"
        },
        {
          "text": "Sprinkle 1/2 teaspoon of salt over the chicken and mix to combine"
        },
        {
          "text": "Set the chicken aside for about 10 minutes (I usually use this time to chop all the vegetables)"
        },
        {
          "text": "Scramble the egg:"
        },
        {
          "text": "Heat a wok or large sauté pan over medium-high heat"
        },
        {
          "text": "Swirl in a tablespoon of oil and add the whisked eggs"
        },
        {
          "text": "Use a spatula to quickly scramble the eggs, breaking the curds into smaller pieces as they come together"
        },
        {
          "text": "Transfer the eggs to a plate"
        },
        {
          "text": "Cook the chicken:"
        },
        {
          "text": "Add another tablespoon of oil in the wok or pan"
        },
        {
          "text": "Add the chicken and cook for 4 to 5 minutes, stirring occasionally"
        },
        {
          "text": "Turn off the heat and transfer the cooked chicken to a plate"
        },
        {
          "text": "Using your spatula, scrape off any chicken bits that are still stuck to the wok so they don't burn during the next step"
        },
        {
          "text": "You can also use paper towels to wipe down your wok or pan"
        },
        {
          "text": "Cook the vegetables:"
        },
        {
          "text": "Swirl 1 tablespoon of oil into the wok over medium-high heat"
        },
        {
          "text": "Add the diced onions and cook them for 1 minute, until they start to soften"
        },
        {
          "text": "Mix in the minced garlic and ginger and cook until fragrant, about 30 seconds"
        },
        {
          "text": "Add the diced carrots and cook for 2 minutes, stirring frequently"
        },
        {
          "text": "Add 1/2 teaspoon salt and the peas, and stir to incorporate"
        },
        {
          "text": "Cook the rice:"
        },
        {
          "text": "Add the rice to the wok or pan on top of the vegetables and stir to combine"
        },
        {
          "text": "Using the back of your spatula, smash any large chunks of rice to break them apart"
        },
        {
          "text": "Add the white and green parts of the sliced scallions (save the dark green parts) and five-spice powder"
        },
        {
          "text": "Stir to incorporate"
        },
        {
          "text": "If the rice starts to stick to the pan, stir in a little more oil"
        },
        {
          "text": "Drizzle the soy sauce and sesame oil over the rice and stir to incorporate"
        },
        {
          "text": "Stir in the cooked chicken, scrambled eggs, and the dark parts of the scallions"
        },
        {
          "text": "Stir briefly to bring it together, and cook for another 1 to 2 minutes"
        },
        {
          "text": "Serve:"
        },
        {
          "text": "Taste, and add more soy sauce if necessary"
        },
        {
          "text": "Serve immediately."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
    {
      "id": "tmdb-53400",
      "title": "Mastawa Lamb and Rice",
      "description": "Receta de cocina internacional (categoría: Lamb). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/4kzx4d1779554755.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "internacional",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Lamb",
          "quantity": 700,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Onion",
          "quantity": 3,
          "unit": "Medium",
          "category": "verduras"
        },
        {
          "name": "Turmeric",
          "quantity": 1,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Orange",
          "quantity": 1,
          "unit": "large",
          "category": "frutas"
        },
        {
          "name": "Rice",
          "quantity": 150,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Natural yoghurt",
          "quantity": 500,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Garlic clove",
          "quantity": 4,
          "unit": "Cloves Crushed",
          "category": "verduras"
        },
        {
          "name": "Vegetable oil",
          "quantity": 1,
          "unit": "tblsp",
          "category": "despensa"
        },
        {
          "name": "Dried dill",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "otros"
        },
        {
          "name": "Black pepper",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "verduras"
        },
        {
          "name": "Chickpeas",
          "quantity": 1,
          "unit": "Can",
          "category": "granos"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "To taste",
          "category": "condimentos"
        }
      ],
      "steps": [
        {
          "text": "1"
        },
        {
          "text": "Place the meat cut into pieces, in a large pan with the onions"
        },
        {
          "text": "Add the turmeric and enough water to cover"
        },
        {
          "text": "Bring to the boil then cook gently until the meat is very tender and can easily be removed from the bones"
        },
        {
          "text": "2"
        },
        {
          "text": "While the meat is cooking, cut the orange peel into thin match style pieces, removing as much pith as possible"
        },
        {
          "text": "Leave to soak in a bowl of water"
        },
        {
          "text": "3"
        },
        {
          "text": "When the meat is tender, remove from the pan and when cool enough, remove the meat from the bones and shred the meat into strips with your hands"
        },
        {
          "text": "Return the meat to the pan"
        },
        {
          "text": "4"
        },
        {
          "text": "Wash the short grain rice and then add to the pan with salt according to taste"
        },
        {
          "text": "The juices should cover the rice by about 2cm, add more water if necessary"
        },
        {
          "text": "Bring back to the boil, then reduce the heat to medium and cook with the lid off, stirring from time to time until the rice is \"al dente\" and the liquid is absorbed"
        },
        {
          "text": "5"
        },
        {
          "text": "Add the natural yoghurt, and stir in well but carefully"
        },
        {
          "text": "Fry the crushed cloves of garlic in the oil and add to the dish along with the dill, black pepper, the chickpeas and extra salt to taste"
        },
        {
          "text": "6"
        },
        {
          "text": "Mix in well, then cover the top of the pan with a clean thick cloth and the lid"
        },
        {
          "text": "Leave on a low heat for about half an hour to allow the flavours to absorb"
        },
        {
          "text": "Enjoy with some warm nan bread for extra comfort"
        }
      ],
      "tips": [],
