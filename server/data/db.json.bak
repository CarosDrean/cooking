          "category": "condimentos"
        },
        {
          "name": "Tomato puree",
          "quantity": 3,
          "unit": "tsp",
          "category": "verduras"
        },
        {
          "name": "Red pepper",
          "quantity": 2,
          "unit": "diced",
          "category": "verduras"
        },
        {
          "name": "Onion",
          "quantity": 1,
          "unit": "Diced",
          "category": "verduras"
        },
        {
          "name": "Chilli flakes",
          "quantity": 0.25,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "Pinch",
          "category": "condimentos"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "Pinch",
          "category": "verduras"
        },
        {
          "name": "Olive oil",
          "quantity": 1,
          "unit": "Splash",
          "category": "despensa"
        },
        {
          "name": "Boiling water",
          "quantity": 1,
          "unit": "L",
          "category": "despensa"
        }
      ],
      "steps": [
        {
          "text": "1"
        },
        {
          "text": "Cooking"
        },
        {
          "text": "Add some olive oil to a saute pan or saucepan (one with a lid)"
        },
        {
          "text": "One heated add in the onions, diced beef, red peppers and fry for 5 minutes stirring occasionally"
        },
        {
          "text": "The meat should be fully browned"
        },
        {
          "text": "2"
        },
        {
          "text": "Add the paprika, tomato puree, chilli flakes and season with salt and pepper"
        },
        {
          "text": "Mix together and continue to fry for 2 minutes"
        },
        {
          "text": "3"
        },
        {
          "text": "Add the cabbage and stir the mixture together"
        },
        {
          "text": "Fry the mixture while stirring occasionally for 3-5 minutes"
        },
        {
          "text": "Most of the oil should have burned away"
        },
        {
          "text": "4"
        },
        {
          "text": "Pour the boiling water into the pan, ensuring that the water level completely covers the cabbage, plus about 1 inch above it"
        },
        {
          "text": "Put on the lid and bring to the boil"
        },
        {
          "text": "5"
        },
        {
          "text": "Leave to simmer for 2.5 hours"
        },
        {
          "text": "The stew is ready when the cabbage is soft and meat tender"
        },
        {
          "text": "6"
        },
        {
          "text": "Serving"
        },
        {
          "text": "Serve into wide bowls and leave to cool for 5 minutes."
        }
      ],
