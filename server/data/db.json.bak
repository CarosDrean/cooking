    {
      "id": "tmdb-53373",
      "title": "Air Fryer Egg Rolls",
      "description": "Receta de Chinese (categoría: Side). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/grhn401765687086.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "chinese",
      "suitableFor": [
        "desayuno",
        "almuerzo"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Olive oil",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "despensa"
        },
        {
          "name": "Ground pork",
          "quantity": 1,
          "unit": "lb",
          "category": "proteinas"
        },
        {
          "name": "Garlic",
          "quantity": 1,
          "unit": "clove peeled crushed",
          "category": "verduras"
        },
        {
          "name": "Ginger",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "otros"
        },
        {
          "name": "Carrots",
          "quantity": 1,
          "unit": "medium",
          "category": "verduras"
        },
        {
          "name": "Scallions",
          "quantity": 3,
          "unit": "chopped",
          "category": "otros"
        },
        {
          "name": "Cabbage",
          "quantity": 3,
          "unit": "Cups",
          "category": "otros"
        },
        {
          "name": "Soy sauce",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "condimentos"
        },
        {
          "name": "Rice vinegar",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "granos"
        },
        {
          "name": "Egg roll wrappers",
          "quantity": 12,
          "unit": "unidades",
          "category": "proteinas"
        },
        {
          "name": "Oil",
          "quantity": 1,
          "unit": "For brushing",
          "category": "despensa"
        },
        {
          "name": "Duck sauce",
          "quantity": 1,
          "unit": "To serve",
          "category": "otros"
        },
        {
          "name": "Plum sauce",
          "quantity": 1,
          "unit": "To serve",
          "category": "otros"
        },
        {
          "name": "Soy sauce",
          "quantity": 1,
          "unit": "To serve",
          "category": "condimentos"
        }
      ],
      "steps": [
        {
          "text": "Alternative Pan Fry Method: If you don’t have access to an air fryer, you can make these egg rolls using a traditional pan fry method"
        },
        {
          "text": "Add enough oil to a medium skillet with high walls so the oil is about 1/2 inch up the side of the skillet"
        },
        {
          "text": "Heat oil on medium high heat until it reaches 350°F"
        },
        {
          "text": "Add egg rolls and fry for 3 to 4 minutes, flip, and fry for another 3 to 4 minutes until golden brown"
        },
        {
          "text": "Remove and let them drain and cool on a few paper towels"
        },
        {
          "text": "Cook the filling:"
        },
        {
          "text": "In a large skillet over medium heat, add the olive oil along with the ground pork or chicken"
        },
        {
          "text": "Break apart the meat with a spatula or wooden spoon as it cooks"
        },
        {
          "text": "Cook until the meat is cooked through, 6 to 8 minutes"
        },
        {
          "text": "Add garlic, ginger, carrot, scallions, and cabbage"
        },
        {
          "text": "Continue to cook until cabbage wilts down and is soft, another 3 to 4 minutes, stirring regularly"
        },
        {
          "text": "Season the filling with soy sauce and rice wine vinegar, and take off the heat to cool"
        },
        {
          "text": "(This filling can be made in advance.)"
        },
        {
          "text": "Assemble the egg rolls:"
        },
        {
          "text": "Place a single egg roll wrapper on a dry surface with one point of the square facing you (like a diamond)"
        },
        {
          "text": "Place about 1/4 cup of the egg roll filling mixture in the middle of the wrapper"
        },
        {
          "text": "Dip your fingers in water and run around the edges of the wrapper"
        },
        {
          "text": "Then fold the edges of the wrapper over the center and start rolling the egg roll away from you to form a tight cylinder"
        },
        {
          "text": "Place on a plate and repeat until you are out of filling"
        },
        {
          "text": "You should get at least a dozen egg rolls"
        },
        {
          "text": "Air fry the egg rolls:"
        },
        {
          "text": "Place the egg rolls in the basket of your air fryer"
        },
        {
          "text": "Spray or brush them lightly with oil"
        },
        {
          "text": "Add as many as you can without stacking the egg rolls, making sure they don’t touch"
        },
        {
          "text": "Air needs to circulate around them"
        },
        {
          "text": "Brush the egg rolls lightly with oil"
        },
        {
          "text": "Place the basket in the air fryer and turn the air fryer to 350°F"
        },
        {
          "text": "Cook for 6 to 7 minutes, then flip the egg rolls, spray or brush with oil a second time on the bottom side, and cook for another 4 to 5 minutes"
        },
        {
          "text": "Finished egg rolls should be golden brown and crispy! Serve immediately."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
