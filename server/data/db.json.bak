      "id": "tmdb-53410",
      "title": "Presh me Oriz Leek and Rice Bake",
      "description": "Receta de cocina internacional (categoría: Lamb). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/sjfgbc1779647169.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
