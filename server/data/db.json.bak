      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Avocado",
          "quantity": 3,
          "unit": "Large",
          "category": "verduras"
        },
        {
          "name": "Natural yoghurt",
          "quantity": 200,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Lime",
          "quantity": 1,
          "unit": "Zest and juice of 1",
          "category": "otros"
        },
        {
          "name": "Lemon",
          "quantity": 1,
          "unit": "Juice of 1/2",
          "category": "frutas"
        },
        {
          "name": "Baby new potatoes",
          "quantity": 1.25,
          "unit": "kg",
          "category": "verduras"
        },
        {
          "name": "Olive oil",
          "quantity": 2,
          "unit": "tablespoons",
          "category": "despensa"
        },
        {
          "name": "Hot chilli powder",
          "quantity": 1,
          "unit": "teaspoon",
          "category": "otros"
        },
        {
          "name": "Cumin seeds",
          "quantity": 1,
          "unit": "teaspoon",
          "category": "condimentos"
        },
        {
          "name": "Tortillas",
          "quantity": 200,
          "unit": "g",
          "category": "granos"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Whizz half the avocado flesh with the yogurt, lime and lemon juice and seasoning"
        },
        {
          "text": "Dice the remaining avocado, then gently stir into the whizzed mix with most of the lime zest"
        },
        {
          "text": "Cover, then chill until ready to serve"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Boil potatoes for 6 mins, then drain well and toss with olive oil, chilli powder and cumin seeds"
        },
        {
          "text": "Now set aside until half an hour before your guests arrive"
        },
        {
          "text": "step 3"
        },
        {
          "text": "Heat oven to 200C/180C fan/gas 6, then roast potatoes for about 30 mins, shaking the tray halfway, until golden and tender"
        },
        {
          "text": "Transfer the dip to one or two bowls, scatter with the remaining lime zest and serve with the hot potatoes, and tortilla chips for dipping."
        }
      ],
