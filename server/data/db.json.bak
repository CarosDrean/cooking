        },
        {
          "name": "Peppercorns",
          "quantity": 12,
          "unit": "unidades",
          "category": "verduras"
        },
        {
          "name": "Juniper berries",
          "quantity": 4,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Allspice berries",
          "quantity": 4,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Red wine",
          "quantity": 90,
