          "category": "verduras"
        }
      ],
      "steps": [
        {
          "text": "Boil: Bring water to a boil, gently add eggs, and cook for exactly 6½ to 7 minutes"
        },
        {
          "text": "Ice Bath: Immediately transfer the eggs to a bowl of ice water for 3–5 minutes to stop cooking"
        },
        {
          "text": "Marinate (Optional but recommended): Peel the eggs and marinate in a mix of 2 tbsp soy sauce, 2 tbsp mirin, 1 tsp sugar, and 4 tbsp water for at least 4 hours (or overnight)"
        },
        {
          "text": "Serve: Slice in half, letting the yolk flow into the broth"
        }
      ],
      "tips": [],
