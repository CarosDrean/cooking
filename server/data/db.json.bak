    {
      "id": "tmdb-52816",
      "title": "Roasted Eggplant With Tahini, Pine Nuts, and Lentils",
      "description": "Receta de United States (categoría: Vegetarian). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/ysqrus1487425681.jpg",
      "source": "themealdb",
      "diets": [
        "vegetariano",
        "sin-lactosa"
      ],
      "cuisine": "united states",
      "suitableFor": [
        "desayuno",
        "almuerzo"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Olive oil",
          "quantity": 2,
          "unit": "tablespoons",
          "category": "despensa"
        },
        {
          "name": "Carrots",
          "quantity": 2,
          "unit": "small cut into chunks",
          "category": "verduras"
        },
        {
          "name": "Celery",
          "quantity": 2,
          "unit": "small stalks",
          "category": "otros"
        },
        {
          "name": "Onion",
          "quantity": 1,
          "unit": "medium finely diced",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 6,
          "unit": "medium cloves sliced",
          "category": "verduras"
        },
        {
          "name": "Brown lentils",
          "quantity": 12,
          "unit": "ounces (340g)",
          "category": "granos"
        },
        {
          "name": "Bay leaves",
          "quantity": 2,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Water",
          "quantity": 4,
          "unit": "cups",
          "category": "despensa"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "Pinch",
          "category": "condimentos"
        },
        {
          "name": "Apple cider vinegar",
          "quantity": 2,
          "unit": "teaspoons (10ml)",
          "category": "frutas"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "Pinch",
          "category": "verduras"
        },
        {
          "name": "Egg plants",
          "quantity": 2,
          "unit": "large",
          "category": "proteinas"
        },
        {
          "name": "Rosemary",
          "quantity": 4,
          "unit": "sprigs",
          "category": "condimentos"
        },
        {
          "name": "Pine nuts",
          "quantity": 0.25,
          "unit": "cup",
          "category": "otros"
        },
        {
          "name": "Parsley",
          "quantity": 2,
          "unit": "tablespoons",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "For the Lentils: Adjust oven rack to center position and preheat oven to 450°F to prepare for roasting eggplant"
        },
        {
          "text": "Meanwhile, heat 2 tablespoons olive oil in a medium saucepan over medium heat until shimmering"
        },
        {
          "text": "Add carrots, celery, and onion and cook, stirring, until softened but not browned, about 4 minutes"
        },
        {
          "text": "Add garlic and cook, stirring, until fragrant, about 30 seconds"
        },
        {
          "text": "Add lentils, bay leaves, stock or water, and a pinch of salt"
        },
        {
          "text": "Bring to a simmer, cover with the lid partially ajar, and cook until lentils are tender, about 30 minutes"
        },
        {
          "text": "(Top up with water if lentils are at any point not fully submerged.) Remove lid, stir in vinegar, and reduce until lentils are moist but not soupy"
        },
        {
          "text": "Season to taste with salt and pepper, cover, and keep warm until ready to serve"
        },
        {
          "text": "2"
        },
        {
          "text": "For the Eggplant: While lentils cook, cut each eggplant in half"
        },
        {
          "text": "Score flesh with the tip of a paring knife in a cross-hatch pattern at 1-inch intervals"
        },
        {
          "text": "Transfer to a foil-lined rimmed baking sheet, cut side up, and brush each eggplant half with 1 tablespoon oil, letting each brushstroke be fully absorbed before brushing with more"
        },
        {
          "text": "Season with salt and pepper"
        },
        {
          "text": "Place a rosemary sprig on top of each one"
        },
        {
          "text": "Transfer to oven and roast until completely tender and well charred, 25 to 35 minutes"
        },
        {
          "text": "Remove from oven and discard rosemary"
        },
        {
          "text": "3"
        },
        {
          "text": "To Serve: Heat 2 tablespoons olive oil and pine nuts in a medium skillet set over medium heat"
        },
        {
          "text": "Cook, tossing nuts frequently, until golden brown and aromatic, about 4 minutes"
        },
        {
          "text": "Transfer to a bowl to halt cooking"
        },
        {
          "text": "Stir half of parsley and rosemary into lentils and transfer to a serving platter"
        },
        {
          "text": "Arrange eggplant halves on top"
        },
        {
          "text": "Spread a few tablespoons of tahini sauce over each eggplant half and sprinkle with pine nuts"
        },
        {
          "text": "Sprinkle with remaining parsley and rosemary, drizzle with additional olive oil, and serve."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
    {
      "id": "tmdb-52955",
      "title": "Egg Drop Soup",
      "description": "Receta de Chinese (categoría: Vegetarian). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/1529446137.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "chinese",
      "suitableFor": [
        "desayuno",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Chicken stock",
          "quantity": 3,
          "unit": "cups",
          "category": "proteinas"
        },
        {
          "name": "Salt",
          "quantity": 0.25,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Sugar",
          "quantity": 0.25,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "pinch",
          "category": "verduras"
        },
        {
          "name": "Sesame seed oil",
          "quantity": 1,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Peas",
          "quantity": 0.33,
          "unit": "cup",
          "category": "otros"
        },
        {
          "name": "Mushrooms",
          "quantity": 0.33,
          "unit": "cup",
          "category": "otros"
        },
        {
          "name": "Cornstarch",
          "quantity": 1,
          "unit": "tbs",
          "category": "granos"
        },
        {
          "name": "Water",
          "quantity": 2,
          "unit": "tbs",
          "category": "despensa"
        },
        {
          "name": "Spring onions",
          "quantity": 0.25,
          "unit": "cup",
          "category": "verduras"
        }
      ],
      "steps": [
        {
          "text": "In a wok add chicken broth and wait for it to boil"
        },
        {
          "text": "Next add salt, sugar, white pepper, sesame seed oil"
        },
        {
          "text": "When the chicken broth is boiling add the vegetables to the wok"
        },
        {
          "text": "To thicken the sauce, whisk together 1 Tablespoon of cornstarch and 2 Tablespoon of water in a bowl and slowly add to your soup until it's the right thickness"
        },
        {
          "text": "Next add 1 egg slightly beaten with a knife or fork and add it to the soup slowly and stir for 8 seconds"
        },
        {
          "text": "Serve the soup in a bowl and add the green onions on top."
        }
      ],
      "tips": [],
