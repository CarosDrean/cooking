      "title": "Katsu Chicken curry",
      "description": "Receta de Japanese (categoría: Chicken). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/vwrpps1503068729.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "japanese",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Chicken breast",
          "quantity": 4,
          "unit": "pounded to 1cm thickness",
          "category": "proteinas"
        },
        {
          "name": "Plain flour",
          "quantity": 2,
          "unit": "tablespoons",
          "category": "granos"
        },
        {
          "name": "Egg",
          "quantity": 1,
          "unit": "beaten",
          "category": "proteinas"
        },
        {
          "name": "Breadcrumbs",
          "quantity": 100,
          "unit": "g fine",
          "category": "granos"
        },
        {
          "name": "Vegetable oil",
          "quantity": 230,
          "unit": "ml frying",
          "category": "despensa"
        },
        {
          "name": "Sunflower oil",
          "quantity": 2,
          "unit": "tablespoons",
          "category": "despensa"
        },
        {
          "name": "Onions",
          "quantity": 2,
          "unit": "sliced",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 5,
          "unit": "chopped cloves",
          "category": "verduras"
        },
        {
          "name": "Carrot",
          "quantity": 2,
          "unit": "sliced",
          "category": "verduras"
        },
        {
          "name": "Plain flour",
          "quantity": 2,
          "unit": "tablespoons",
          "category": "granos"
        },
        {
          "name": "Curry powder",
          "quantity": 4,
          "unit": "teaspoons",
          "category": "condimentos"
        },
        {
          "name": "Chicken stock",
          "quantity": 600,
          "unit": "ml",
          "category": "proteinas"
        },
        {
          "name": "Honey",
          "quantity": 2,
          "unit": "teaspoons",
          "category": "despensa"
        },
        {
          "name": "Soy sauce",
          "quantity": 4,
          "unit": "teaspoons",
          "category": "condimentos"
        },
        {
          "name": "Bay leaf",
          "quantity": 1,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Garam masala",
          "quantity": 1,
          "unit": "teaspoon",
          "category": "condimentos"
        }
      ],
      "steps": [
        {
          "text": "Prep:15min  ›  Cook:30min  ›  Ready in:45min"
        },
        {
          "text": "For the curry sauce: Heat oil in medium non-stick saucepan, add onion and garlic and cook until softened"
        },
        {
          "text": "Stir in carrots and cook over low heat for 10 to 12 minutes"
        },
        {
          "text": "Add flour and curry powder; cook for 1 minute"
        },
        {
          "text": "Gradually stir in stock until combined; add honey, soy sauce and bay leaf"
        },
        {
          "text": "Slowly bring to the boil"
        },
        {
          "text": "Turn down heat and simmer for 20 minutes or until sauce thickens but is still of pouring consistency"
        },
        {
          "text": "Stir in garam masala"
        },
        {
          "text": "Pour the curry sauce through a sieve; return to saucepan and keep on low heat until ready to serve"
        },
        {
          "text": "For the chicken: Season both sides of chicken breasts with salt and pepper"
        },
        {
          "text": "Place flour, egg and breadcrumbs in separate bowls and arrange in a row"
        },
        {
          "text": "Coat the chicken breasts in flour, then dip them into the egg, then coat in breadcrumbs, making sure you cover both sides"
        },
        {
          "text": "Heat oil in large frying pan over medium-high heat"
        },
        {
          "text": "Place chicken into hot oil and cook until golden brown, about 3 or 4 minutes each side"
        },
        {
          "text": "Once cooked, place on kitchen paper to absorb excess oil"
        },
        {
          "text": "Pour curry sauce over chicken, serve with white rice and enjoy!"
        }
      ],
