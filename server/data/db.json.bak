    {
      "id": "tmdb-53211",
      "title": "Lemongrass beef stew with noodles",
      "description": "Receta de Thai (categoría: Beef). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/ntafxw1763586291.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "thai",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Ginger",
          "quantity": 1,
          "unit": "tablespoon chopped",
          "category": "otros"
        },
        {
          "name": "Garlic clove",
          "quantity": 2,
          "unit": "chopped",
          "category": "verduras"
        },
        {
          "name": "Lemongrass stalks",
          "quantity": 3,
          "unit": "unidades",
          "category": "frutas"
        },
        {
          "name": "Coriander leaves",
          "quantity": 2,
          "unit": "tblsp",
          "category": "otros"
        },
        {
          "name": "Red chilli",
          "quantity": 2,
          "unit": "sliced",
          "category": "otros"
        },
        {
          "name": "Vegetable oil",
          "quantity": 2,
          "unit": "tblsp",
          "category": "despensa"
        },
        {
          "name": "Beef",
          "quantity": 250,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Soy sauce",
          "quantity": 2,
          "unit": "tblsp",
          "category": "condimentos"
        },
        {
          "name": "Five spice powder",
          "quantity": 1,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Brown sugar",
          "quantity": 1,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Beef stock",
          "quantity": 400,
          "unit": "ml",
          "category": "proteinas"
        },
        {
          "name": "Rice noodles",
          "quantity": 100,
          "unit": "g",
