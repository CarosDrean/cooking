    {
      "id": "tmdb-52831",
      "title": "Chicken Karaage",
      "description": "Receta de Japanese (categoría: Chicken). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/tyywsw1505930373.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "japanese",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Chicken",
          "quantity": 450,
          "unit": "grams Boneless skin",
          "category": "proteinas"
        },
        {
          "name": "Ginger",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "otros"
        },
        {
          "name": "Garlic",
          "quantity": 1,
          "unit": "clove",
          "category": "verduras"
        },
        {
          "name": "Soy sauce",
          "quantity": 2,
          "unit": "tablespoons",
          "category": "condimentos"
        },
        {
          "name": "Sake",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "otros"
        },
        {
          "name": "Granulated sugar",
          "quantity": 2,
          "unit": "teaspoon",
          "category": "despensa"
        },
        {
          "name": "Potato starch",
          "quantity": 0.33,
          "unit": "cup",
          "category": "verduras"
        },
        {
          "name": "Vegetable oil",
          "quantity": 0.33,
          "unit": "cup",
          "category": "despensa"
        },
        {
          "name": "Lemon",
          "quantity": 0.33,
          "unit": "cup",
          "category": "frutas"
        }
      ],
      "steps": [
        {
          "text": "Add the ginger, garlic, soy sauce, sake and sugar to a bowl and whisk to combine"
        },
        {
          "text": "Add the chicken, then stir to coat evenly"
        },
        {
          "text": "Cover and refrigerate for at least 1 hour"
        },
        {
          "text": "Add 1 inch of vegetable oil to a heavy bottomed pot and heat until the oil reaches 360 degrees F"
        },
        {
          "text": "Line a wire rack with 2 sheets of paper towels and get your tongs out"
        },
        {
          "text": "Put the potato starch in a bowl"
        },
        {
          "text": "Add a handful of chicken to the potato starch and toss to coat each piece evenly"
        },
        {
          "text": "Fry the karaage in batches until the exterior is a medium brown and the chicken is cooked through"
        },
        {
          "text": "Transfer the fried chicken to the paper towel lined rack"
        },
        {
          "text": "If you want the karaage to stay crispy longer, you can fry the chicken a second time, until it's a darker color after it's cooled off once"
        },
        {
          "text": "Serve with lemon wedges."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
    {
      "id": "tmdb-52918",
      "title": "Fish Stew with Rouille",
      "description": "Receta de France (categoría: Seafood). Importada de TheMealDB.",
      "emoji": "🍽️",
