          "quantity": 200,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Chicken stock",
          "quantity": 0.5,
          "unit": "L",
          "category": "proteinas"
        },
        {
          "name": "Thyme",
          "quantity": 6,
          "unit": "parts",
          "category": "condimentos"
        },
        {
          "name": "Paella rice",
          "quantity": 375,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Lemon juice",
          "quantity": 1,
          "unit": "unidades",
          "category": "frutas"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Heat oven to 200C/180C/gas 6"
        },
        {
          "text": "Heat half the oil in a deep frying or sauté pan (or shallow casserole dish) measuring around 30cm in diameter"
        },
        {
          "text": "Over a high heat, colour the pork belly slices on each side in several batches, then transfer to a bowl"
        },
        {
          "text": "Add the remaining oil to the pan and lower the heat to medium, then add the black pudding and bacon and fry all over for several mins"
        },
        {
          "text": "Remove with a slotted spoon"
        },
        {
          "text": "Fry the onion and peppers for around 10 mins until soft and pale gold, then add the tomato and cook until soft"
        },
        {
          "text": "Add the garlic, smoked paprika and chilli flakes and cook for another 2 mins, then put the pork, black pudding and bacon back in the pan"
        },
        {
          "text": "Add the beans, stock and whichever herb you're using, and bring everything to the boil"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Sprinkle the rice around the pork belly, pushing it underneath the stock"
        },
        {
          "text": "Let the stock come to the boil again, season well, then transfer to the oven (leave it uncovered)"
        },
        {
          "text": "Cook for 20 mins without stirring, then check to see how the rice is doing"
        },
        {
          "text": "The rice should be tender and the stock absorbed"
        },
        {
          "text": "If it’s not ready, put back in the oven for another 5 mins, then check again"
        },
        {
          "text": "Taste for seasoning"
        },
        {
          "text": "step 3"
        },
        {
          "text": "Squeeze lemon juice over the top and drizzle over some extra virgin olive oil just before serving, if you like."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
    {
      "id": "tmdb-53161",
      "title": "Chicken & chorizo rice pot",
      "description": "Receta de Spanish (categoría: Chicken). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/fk80jp1763280767.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "spanish",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Oil",
          "quantity": 1,
          "unit": "tblsp",
          "category": "despensa"
        },
        {
          "name": "Chicken",
          "quantity": 1,
          "unit": "whole",
          "category": "proteinas"
        },
        {
          "name": "Onion",
          "quantity": 1,
