    {
      "id": "tmdb-52956",
      "title": "Chicken Congee",
      "description": "Receta de Chinese (categoría: Chicken). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/1529446352.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "chinese",
      "suitableFor": [
        "almuerzo",
        "cena"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Chicken",
          "quantity": 8,
          "unit": "oz",
          "category": "proteinas"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "pinch",
          "category": "condimentos"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "pinch",
          "category": "verduras"
        },
        {
          "name": "Ginger cordial",
          "quantity": 1,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Ginger",
          "quantity": 1,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Spring onions",
          "quantity": 1,
          "unit": "tbs",
          "category": "verduras"
        },
        {
          "name": "Rice",
          "quantity": 0.5,
          "unit": "cup",
          "category": "granos"
        },
        {
          "name": "Water",
          "quantity": 8,
          "unit": "cups",
          "category": "despensa"
        },
        {
          "name": "Coriander",
          "quantity": 2,
          "unit": "oz",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "STEP 1 - MARINATING THE CHICKEN"
        },
        {
          "text": "In a bowl, add chicken, salt, white pepper, ginger juice and then mix it together well"
        },
        {
          "text": "Set the chicken aside"
        },
        {
          "text": "STEP 2 - RINSE THE WHITE RICE"
        },
        {
          "text": "Rinse the rice in a metal bowl or pot a couple times and then drain the water"
        },
        {
          "text": "STEP 2 - BOILING THE WHITE RICE"
        },
        {
          "text": "Next add 8 cups of water and then set the stove on high heat until it is boiling"
        },
        {
          "text": "Once rice porridge starts to boil, set the stove on low heat and then stir it once every 8-10 minutes for around 20-25 minutes"
        },
        {
          "text": "After 25 minutes, this is optional but you can add a little bit more water to make rice porridge to make it less thick or to your preference"
        },
        {
          "text": "Next add the marinated chicken to the rice porridge and leave the stove on low heat for another 10 minutes"
        },
        {
          "text": "After an additional 10 minutes add the green onions, sliced ginger, 1 pinch of salt, 1 pinch of white pepper and stir for 10 seconds"
        },
        {
          "text": "Serve the rice porridge in a bowl"
        },
        {
          "text": "Optional: add Coriander on top of the rice porridge."
        }
      ],
