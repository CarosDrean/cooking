    {
      "id": "tmdb-53056",
      "title": "Croatian lamb peka",
      "description": "Receta de Croatian (categoría: Beef). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/pn59o51628769837.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "croatian",
      "suitableFor": [
        "desayuno",
        "almuerzo"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Potatoes",
          "quantity": 600,
          "unit": "g",
          "category": "verduras"
        },
        {
          "name": "Courgettes",
          "quantity": 1,
          "unit": "chopped",
          "category": "otros"
        },
        {
          "name": "Carrots",
          "quantity": 1,
          "unit": "chopped",
          "category": "verduras"
        },
        {
          "name": "Green pepper",
          "quantity": 1,
          "unit": "chopped",
          "category": "verduras"
        },
        {
          "name": "Aubergine",
          "quantity": 1,
          "unit": "small",
          "category": "otros"
        },
        {
          "name": "Onion",
          "quantity": 1,
          "unit": "Large Chopped",
          "category": "verduras"
        },
        {
          "name": "Lamb shoulder",
          "quantity": 800,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Garlic sauce",
          "quantity": 1,
          "unit": "tbs",
          "category": "verduras"
        },
        {
          "name": "Tomato puree",
          "quantity": 1,
          "unit": "tbs",
          "category": "verduras"
        },
        {
          "name": "Olive oil",
          "quantity": 80,
          "unit": "ml",
          "category": "despensa"
        },
        {
          "name": "Thyme",
          "quantity": 1,
          "unit": "Sprinking",
          "category": "condimentos"
        },
        {
          "name": "White wine",
          "quantity": 250,
          "unit": "ml",
          "category": "otros"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "Pinch",
          "category": "verduras"
        }
      ],
      "steps": [
        {
          "text": "Preheat oven to 200°C fan / 220°C / 425°F / Gas mark 7"
        },
        {
          "text": "If you have not bought diced lamb, cut your lamb shoulder or leg into large chunks and place to one side"
        },
        {
          "text": "Chunks of chopped lamb of a red chopping board"
        },
        {
          "text": "Make oil marinade -"
        },
        {
          "text": "Mix 80ml of olive oil in a bowl with garlic puree, sundried tomato puree ,black pepper and salt"
        },
        {
          "text": "olive oil, gia sundried tomato puree and gia garlic puree and black pepper mixed together in a silver bowl to make Croatian peka"
        },
        {
          "text": "Add potatoes and vegetables into a large lidded casserole dish"
        },
        {
          "text": "Chopped up vegetables which consist of chopped up red onion, courgette, potatoes red peppers in a cast iron pan"
        },
        {
          "text": "Place diced lamb on top of the vegetables, pour the marinade and wine over the top"
        },
        {
          "text": "Chunks of lamb covered in in a sundried tomato oil sauce which is on top of chopped red onion, aubergine, courgette and potatoes in a cast iron pan"
        },
        {
          "text": "Add the rosemary, thyme and sage, trying to keep the herbs on top"
        },
        {
          "text": "So you can easily remove the herb stalks once cooked"
        },
        {
          "text": "Chunks of lamb coated in a sundried tomato oil sauce and covered with thyme, rosemary and sage which is on top of chopped red onion, aubergine, courgette and potatoes in a cast iron pan"
        },
        {
          "text": "Place lid on the casserole dish and cook for 1hr 30 minute"
        },
        {
          "text": "If you do not have a lid cover very well with kitchen foil"
        },
        {
          "text": "Cast iron dish with lid on in the oven"
        },
        {
          "text": "Take the lid off, remove any thick herb stems"
        },
        {
          "text": "Stir in 2 tbsp of olive oil"
        },
        {
          "text": "Cook for a further 20-30 mins"
        },
        {
          "text": "Cooked Croatian Lamb Peka in a cast iron pan in the oven"
        },
        {
          "text": "Serve with fresh homemade bread to dip into the juices."
        }
      ],
      "tips": [],
