    {
      "id": "tmdb-53308",
      "title": "Rye bread",
      "description": "Receta de Polish (categoría: Side). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/lmc6r51764365554.jpg",
      "source": "themealdb",
      "diets": [
        "vegetariano",
        "sin-lactosa"
      ],
      "cuisine": "polish",
      "suitableFor": [
        "desayuno",
        "almuerzo"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Rye",
          "quantity": 200,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Strong white bread flour",
          "quantity": 200,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Yeast",
          "quantity": 10,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Salt",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "condimentos"
        },
        {
          "name": "Honey",
          "quantity": 1,
          "unit": "tablespoon",
          "category": "despensa"
        },
        {
          "name": "Caraway seed",
          "quantity": 1,
          "unit": "tsp",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Tip the flours, yeast and salt into a bowl"
        },
        {
          "text": "In a jug, mix the honey with 250ml warm water, pour the liquid into the bowl and mix to form a dough"
        },
        {
          "text": "Rye flour can be quite dry and absorbs lots of water, if the dough looks too dry add more warm water until you have a soft dough Tip out onto your work surface and knead for 10 mins until smooth"
        },
        {
          "text": "Rye contains less gluten than white flour so the dough will not feel as springy as a conventional white loaf"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Place the dough in a well oiled bowl, cover with cling film and leave to rise in a warm place for 1-2 hrs, or until roughly doubled in size"
        },
        {
          "text": "Dust a 2lb/900g loaf tin with flour"
        },
        {
          "text": "step 3"
        },
        {
          "text": "Tip the dough back onto your work surface and knead briefly to knock out any air bubbles"
        },
        {
          "text": "If using caraway seeds work these in to the dough"
        },
        {
          "text": "Shape into a smooth oval loaf and pop into your tin"
        },
        {
          "text": "Cover the tin with oiled cling film and leave to rise somewhere warm for a further 1 – 1.5 hr, or until doubled in size"
        },
        {
          "text": "step 4"
        },
        {
          "text": "Heat oven to 220C/200C fan/gas 7"
        },
        {
          "text": "Remove the cling film and dust the surface of the loaf with rye flour"
        },
        {
          "text": "Slash a few incisions on an angle then bake for 30 mins until dark brown and hollow sounding when tapped"
        },
        {
          "text": "Transfer to a wire cooling rack and leave to cool for at least 20 mins before serving"
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
    },
