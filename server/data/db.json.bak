          "category": "granos"
        },
        {
          "name": "Bean sprouts",
          "quantity": 200,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Lime",
          "quantity": 1,
          "unit": "Zest and juice of 2",
          "category": "otros"
        },
        {
          "name": "Fish sauce",
          "quantity": 2,
          "unit": "tbsp",
          "category": "proteinas"
        },
        {
          "name": "Muscovado sugar",
          "quantity": 1,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Red onions",
          "quantity": 1,
          "unit": "sliced",
          "category": "verduras"
        },
        {
          "name": "Lettuce",
          "quantity": 2,
          "unit": "small",
          "category": "verduras"
        },
        {
          "name": "Minced pork",
          "quantity": 500,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Ginger",
          "quantity": 1,
          "unit": "Knob",
          "category": "otros"
        },
        {
          "name": "Cayenne pepper",
          "quantity": 1,
          "unit": "Pinch",
          "category": "verduras"
        },
        {
          "name": "Sunflower oil",
          "quantity": 1,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Sesame seed",
          "quantity": 2,
          "unit": "tblsp",
          "category": "otros"
        },
        {
          "name": "Oil",
          "quantity": 1,
          "unit": "tsp",
          "category": "despensa"
        },
        {
          "name": "Sirloin steak",
          "quantity": 4,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Red chilli",
          "quantity": 1,
          "unit": "sliced",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Place the noodles and beansprouts in a heatproof bowl and cover with boiling water"
        },
        {
          "text": "Leave for 4 mins, or until the noodles are tender"
        },
        {
          "text": "Drain, then cool under cold running water and drain again"
        },
        {
          "text": "Return to the bowl"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Stir together the lime zest and juice, fish or soy sauce and sugar"
        },
        {
          "text": "Stir into the noodles with the red onion and lettuce"
        },
        {
          "text": "step 3"
        },
        {
          "text": "To make with mince, heat a little oil in a non-stick frying pan and stir-fry 500g minced pork, a small knob of grated ginger and pinch cayenne pepper or chilli powder for 10 mins, until the mince is browned and cooked through"
        },
        {
          "text": "Mix into the noodles, divide between four bowls and serve warm"
        },
        {
          "text": "step 4"
        },
        {
          "text": "To make with steak, make the rice noodle salad"
        },
        {
          "text": "Heat 1 tsp sunflower oil in a frying pan"
        },
        {
          "text": "Tip 2 tbsp sesame seeds onto a plate"
        },
        {
          "text": "Rub 1 tsp oil into 4 x 175g sirloin steaks and press into sesame seeds"
        },
        {
          "text": "Fry for 5 mins for medium rare, turning halfway"
        },
        {
          "text": "Leave to rest for 5 mins, then thinly slice"
        },
        {
          "text": "Toss 1 deseeded and shredded red chilli, and a handful mint leaves into noodles"
        },
        {
          "text": "Top with steak to serve."
        }
      ],
