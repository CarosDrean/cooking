      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Heat the oil in a deep frying pan, then soften the leek for 5 mins without browning"
        },
        {
          "text": "Add the chorizo and fry until it releases its oils"
        },
        {
          "text": "Stir in the turmeric and rice until coated by the oils, then pour in the stock"
        },
        {
          "text": "Bring to the boil, then simmer for 15 mins, stirring occasionally"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Tip in the peas and cook for 5 mins, then stir in the seafood to heat through for a final 1-2 mins cooking or until rice is cooked"
        },
        {
          "text": "Check for seasoning and serve immediately with lemon wedges."
