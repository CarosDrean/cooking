      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Leek",
          "quantity": 500,
          "unit": "g",
          "category": "otros"
        },
        {
          "name": "Lamb mince",
          "quantity": 400,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Onion",
          "quantity": 1,
          "unit": "Diced",
          "category": "verduras"
        },
        {
          "name": "Rice",
          "quantity": 200,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Lamb stock",
          "quantity": 1,
          "unit": "L",
          "category": "proteinas"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "Pinch",
          "category": "condimentos"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "Pinch",
          "category": "verduras"
        },
        {
          "name": "Olive oil",
          "quantity": 1,
          "unit": "Splash",
          "category": "despensa"
        }
      ],
      "steps": [
        {
          "text": "1"
        },
        {
          "text": "Cooking"
        },
        {
          "text": "Fry the leeks in a small dash of olive oil for a few minutes until they start to brown"
        },
        {
          "text": "2"
        },
        {
          "text": "Add the onions and mince and fry until everything is browned"
        },
        {
          "text": "Ensure you keep stirring to prevent the leeks catching and burning"
        },
        {
          "text": "3"
        },
        {
          "text": "Add the rice and stir together for a few minutes ensuring the rice is well blended and coated in any juices"
        },
        {
          "text": "4"
        },
        {
          "text": "Add the lamb stock, salt and pepper"
        },
        {
          "text": "Give it a good stir and leave it to come to the boil"
        },
        {
          "text": "Leave to boil for 2 minutes"
        },
        {
          "text": "5"
        },
        {
          "text": "Baking"
        },
        {
          "text": "Pour the mixture into a large baking tray, place on the bottom self of a preheated oven at 180 degrees"
        },
        {
          "text": "Leave to bake for up to 1 hour"
        },
        {
          "text": "The dish is ready when all the liquid is evaporated and the rice is soft"
        },
        {
          "text": "6"
        },
        {
          "text": "Serving"
        },
        {
          "text": "Once cooked turn off the oven and keeping the door open leave the leek and rice bake to cool for 10 minutes before serving."
        }
      ],
