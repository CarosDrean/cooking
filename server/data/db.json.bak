    {
      "id": "tmdb-53354",
      "title": "Jamaican Curry Goat",
      "description": "Receta de Jamaican (categoría: Goat). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/uc9qp11764796575.jpg",
      "source": "themealdb",
      "diets": [
        "sin-lactosa"
      ],
      "cuisine": "jamaican",
      "suitableFor": [
        "desayuno"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Goat meat",
          "quantity": 3,
          "unit": "Lbs",
          "category": "proteinas"
        },
        {
          "name": "Jamaican curry powder",
          "quantity": 2.5,
          "unit": "tbsp",
          "category": "condimentos"
        },
        {
          "name": "Ground ginger",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "All-purpose seasoning",
          "quantity": 0.5,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Allspice",
          "quantity": 0.25,
          "unit": "tsp",
          "category": "otros"
        },
        {
          "name": "Onion",
          "quantity": 1,
          "unit": "chopped",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 6,
          "unit": "cloves sliced",
          "category": "verduras"
        },
        {
          "name": "Thyme",
          "quantity": 3,
          "unit": "sprigs",
          "category": "condimentos"
        },
        {
          "name": "Oil",
          "quantity": 2,
          "unit": "tablespoons",
          "category": "despensa"
        },
        {
          "name": "Water",
          "quantity": 0.25,
          "unit": "cup",
          "category": "despensa"
        },
        {
          "name": "Scotch bonnet",
          "quantity": 1,
          "unit": "unidades",
          "category": "otros"
        },
        {
          "name": "Russet potato",
          "quantity": 1,
          "unit": "large",
          "category": "verduras"
        },
        {
          "name": "Salt",
          "quantity": 1,
          "unit": "To taste",
          "category": "condimentos"
        },
        {
          "name": "Pepper",
          "quantity": 1,
          "unit": "To taste",
          "category": "verduras"
        }
      ],
      "steps": [
        {
          "text": "Equipment"
        },
        {
          "text": "6QT Pressure cooker"
        },
        {
          "text": "Instructions"
        },
        {
          "text": "Rinse goat meat with vinegar and water"
        },
        {
          "text": "Season goat meat with 1 ½ tablespoon curry powder, all-purpose seasoning, ground ginger, allspice, onion, garlic cloves, and thyme"
        },
        {
          "text": "Marinate for at least 4 hours or up to overnight"
        },
        {
          "text": "Remove onion and garlic from goat and set aside"
        },
        {
          "text": "Set an electric pressure cooker, like an Instant Pot, on high sauté and add oil"
        },
        {
          "text": "Add goat meat and brown, about 2-3 minutes per side"
        },
        {
          "text": "Remove goat from insert and add 1 tablespoon oil and remaining curry powder and sauté for about 10 seconds"
        },
        {
          "text": "Then add onions and garlic and sauté until softened"
        },
        {
          "text": "About 4 minutes"
        },
        {
          "text": "If the onions look dry, add a little water and continue to sauté"
        },
        {
          "text": "Add goat and water to the pressure cooker and cover the pressure cooker"
        },
        {
          "text": "Cook for 40 minutes on high pressure"
        },
        {
          "text": "Allow to naturally release for 10 minutes, then release the remaining pressure"
        },
        {
          "text": "Once all the pressure has been released, open the pressure cooker"
        },
        {
          "text": "Place on sauté for 10-15 minutes, add potatoes and a whole scotch bonnet pepper"
        },
        {
          "text": "Cook until potatoes have softened"
        },
        {
          "text": "Remove scotch bonnet pepper."
        }
      ],
      "tips": [],
      "nutrition": {
        "kcal": 0,
        "protein": 0,
        "carbs": 0,
        "fat": 0
      }
