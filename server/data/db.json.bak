          "category": "despensa"
        }
      ],
      "steps": [
        {
          "text": "Conch Stew Cooking Directions"
        },
        {
          "text": "Clean conch meat and pound to tenderize"
        },
        {
          "text": "Boil conch for 2 - 3 hours or until tender"
        },
        {
          "text": "Make Sea Pie while conch cooks (instructions below)"
        },
        {
          "text": "Once cool, cut conch in bite size pieces and season"
        },
        {
          "text": "Add all ingredients, except flour, to pan and simmer for 10 to 20 minutes"
        },
        {
          "text": "Mix flour with 1 cup water and pour into pan to thicken"
        },
        {
          "text": "Add Sea Pie pieces and continue to cook for an additional 10 minutes"
        },
        {
          "text": "Sea Pie Cooking Directions"
        },
        {
          "text": "Make dough with flour, pinch of salt and water so that you can roll out as thin as possible, then cut into 2 ½” x 2 ½” squares"
        },
        {
          "text": "Let set for 30 minutes then stretch squares to thin them out and add to conch stew mixture"
        },
        {
          "text": "Serve with white rice, plantain, breadfruit or your choice of vegetables."
        }
      ],
