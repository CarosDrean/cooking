        },
        {
          "text": "Cook, uncovered, at a gentle bubble, for 20 mins, stirring occasionally until the rice is tender"
        },
        {
          "text": "step 3"
        },
        {
          "text": "Stir in the seafood and lemon juice and cook for 2 mins or until piping hot and completely cooked through"
        },
        {
          "text": "Serve in warm bowls scattered with the parsley."
        }
      ],
