    {
      "id": "tmdb-53033",
      "title": "Japanese gohan rice",
      "description": "Receta de Japanese (categoría: Side). Importada de TheMealDB.",
      "emoji": "🍽️",
      "image": "https://www.themealdb.com/images/media/meals/kw92t41604181871.jpg",
      "source": "themealdb",
      "diets": [
        "vegano",
        "vegetariano",
        "sin-lactosa",
        "sin-lactosa"
      ],
      "cuisine": "japanese",
      "suitableFor": [
        "almuerzo",
        "desayuno"
      ],
      "prepMinutes": 15,
      "cookMinutes": 30,
      "servings": 4,
      "ingredients": [
        {
          "name": "Sushi rice",
          "quantity": 300,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Mirin",
          "quantity": 1,
          "unit": "tbs",
          "category": "otros"
        },
        {
          "name": "Pickle juice",
          "quantity": 1,
          "unit": "Garnish",
          "category": "otros"
        },
        {
          "name": "Spring onions",
          "quantity": 1,
          "unit": "Garnish",
          "category": "verduras"
        }
      ],
      "steps": [
        {
          "text": "STEP 1"
        },
        {
          "text": "Rinsing and soaking your rice is key to achieving the perfect texture"
        },
        {
          "text": "Measure the rice into a bowl, cover with cold water, then use your fingers to massage the grains of rice – the water will become cloudy"
        },
        {
          "text": "Drain and rinse again with fresh water"
        },
        {
          "text": "Repeat five more times until the water stays clear"
        },
        {
          "text": "STEP 2"
        },
        {
          "text": "Tip the rinsed rice into a saucepan with 400ml water, or 200ml dashi and 200ml water, bring to the boil, then turn down the heat to a low simmer, cover with a tight-fitting lid with a steam hole and cook for 15 mins"
        },
        {
          "text": "Remove from the heat and leave to sit for another 15 mins, then stir through the mirin"
        },
        {
          "text": "Remove the lid and give it a good stir"
        },
        {
          "text": "Serve with any or all of the optional toppings."
        }
      ],
      "tips": [],
