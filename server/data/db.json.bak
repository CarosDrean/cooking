        },
        {
          "name": "Red pepper",
          "quantity": 1,
          "unit": "chopped",
          "category": "verduras"
        },
        {
          "name": "Garlic",
          "quantity": 3,
          "unit": "Cloves Crushed",
          "category": "verduras"
        },
        {
          "name": "Chorizo",
          "quantity": 225,
          "unit": "g",
          "category": "proteinas"
        },
        {
          "name": "Tomato puree",
          "quantity": 1,
          "unit": "tblsp",
          "category": "verduras"
        },
        {
          "name": "Thyme",
          "quantity": 1,
          "unit": "tablespoon chopped",
          "category": "condimentos"
        },
        {
          "name": "White wine",
          "quantity": 150,
          "unit": "ml",
          "category": "otros"
        },
        {
          "name": "Chicken stock",
          "quantity": 800,
          "unit": "ml",
          "category": "proteinas"
        },
        {
          "name": "Rice",
          "quantity": 400,
          "unit": "g",
          "category": "granos"
        },
        {
          "name": "Parsley",
          "quantity": 2,
          "unit": "tbs chopped",
          "category": "otros"
        }
      ],
      "steps": [
        {
          "text": "step 1"
        },
        {
          "text": "Heat the oil in a large flameproof casserole dish and brown the chicken pieces on all sides – you may have to do this in batches"
        },
        {
          "text": "Remove from the dish and put to one side"
        },
        {
          "text": "step 2"
        },
        {
          "text": "Lower the heat, add the onion and pepper, and gently cook for 10 mins until softened"
        },
        {
          "text": "Add the garlic and chorizo, and cook for a further 2 mins until the chorizo has released some of its oils into the dish"
        },
        {
          "text": "Stir in the tomato purée and cook for 1 min more"
        },
        {
          "text": "step 3"
        },
        {
          "text": "Return the chicken pieces to the dish along with the thyme, white wine and stock"
        },
        {
          "text": "Bring the liquid to a boil, cover the dish with a tight-fitting lid and lower the heat"
        },
        {
          "text": "Cook for 30 mins"
        },
        {
          "text": "step 4"
        },
        {
          "text": "Tip in the rice and stir everything together"
        },
        {
          "text": "Cover, set over a low heat and cook for a further 15 mins, or until the rice is cooked and has absorbed most of the cooking liquid"
        },
        {
          "text": "Remove from the heat and leave the dish to sit for 10 mins to absorb any remaining liquid"
        },
        {
          "text": "Season to taste and scatter with parsley to serve."
        }
      ],
